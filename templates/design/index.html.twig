{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/schedule_form.html.twig' as sf %}
{% import 'components/checklist_editor.html.twig' as ce %}
{% import 'components/_job_picker.html.twig' as jp %}

{% block title %}Dizajn vodič{% endblock %}
{% block page_title %}Dizajn vodič{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Dizajn vodič</span>{% endblock %}

{% block content %}
    {% set neutrals = {'0': '#FFFFFF', '25': '#FAFBFC', '50': '#F5F6F8', '100': '#ECEEF1', '200': '#DDE1E6', '300': '#C3C9D1', '400': '#A1A9B4', '500': '#7E8794', '600': '#5E6672', '700': '#474E58', '800': '#2E333A', '900': '#161A1F', '950': '#0B0F14'} %}
    {% set blues = {'50': '#EEF7FF', '100': '#D9EDFF', '200': '#B5DCFF', '300': '#84C6FF', '400': '#3BA3FF', '500': '#0089FF', '600': '#006FD6', '700': '#0058AB', '800': '#004588', '900': '#06386B', '950': '#072441'} %}

    <div class="card">
        <div class="card-header"><h5>Boje</h5></div>
        <div class="card-body">
            <div class="kt-overline mb-2">Kont plava</div>
            <div class="d-flex flex-wrap gap-2 mb-4">
                {% for k, c in blues %}<div class="text-center"><div style="width: 56px; height: 40px; border-radius: 8px; background: {{ c }}; box-shadow: 0 0 0 1px var(--kt-border);"></div><div class="kt-text-xs mt-1 kt-mono">{{ k }}</div></div>{% endfor %}
            </div>
            <div class="kt-overline mb-2">Grafit (neutralna skala)</div>
            <div class="d-flex flex-wrap gap-2 mb-4">
                {% for k, c in neutrals %}<div class="text-center"><div style="width: 56px; height: 40px; border-radius: 8px; background: {{ c }}; box-shadow: 0 0 0 1px var(--kt-border);"></div><div class="kt-text-xs mt-1 kt-mono">{{ k }}</div></div>{% endfor %}
            </div>
            <div class="kt-overline mb-2">Semantika (prate temu)</div>
            <div class="d-flex flex-wrap gap-2">
                {% for t in ['bg', 'surface', 'surface-2', 'surface-3', 'primary', 'primary-soft', 'success', 'warning', 'danger', 'purple'] %}
                    <div class="text-center"><div style="width: 72px; height: 40px; border-radius: 8px; background: var(--kt-{{ t }}); box-shadow: 0 0 0 1px var(--kt-border);"></div><div class="kt-text-xs mt-1 kt-mono">{{ t }}</div></div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Tipografija</h5></div>
        <div class="card-body">
            <div class="kt-display mb-2">Display 32 · Manrope 700</div>
            <h1>H1 naslov strane</h1>
            <h2>H2 naslov kartice</h2>
            <h3>H3 podnaslov</h3>
            <p class="mb-1">Tekst 14/20, Inter 400. Šćžčđ ŠĆŽČĐ: latin-ext podskup radi.</p>
            <p class="kt-text-sm mb-1">Mali tekst 13/18</p>
            <div class="kt-overline mb-2">Overline labela</div>
            <p class="mb-0"><span class="kt-mono">PIB 100002119 · 20123456</span> (JetBrains Mono) · <span class="kt-num">1.234.567,00 RSD</span> (tabularni brojevi)</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Dugmad</h5></div>
        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <button class="btn btn-primary">Primarno</button>
            <button class="btn btn-outline-secondary">Sekundarno</button>
            <button class="btn btn-ghost">Ghost</button>
            <button class="btn btn-outline-danger">Opasno (ghost)</button>
            <button class="btn btn-primary is-loading">Učitavanje</button>
            <button class="btn btn-primary" disabled>Onemogućeno</button>
            <button class="btn btn-outline-secondary btn-sm">Kompaktno</button>
            <button class="btn btn-outline-secondary kt-btn-icon rounded-pill" title="Ikonica">{{ ux_icon('lucide:pencil', {class: 'kt-icon'}) }}</button>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Badge-ovi i avatari</h5></div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge kt-badge-secondary">Novo</span>
                <span class="badge kt-badge-primary">U radu</span>
                <span class="badge kt-badge-warning">Čeka klijenta</span>
                <span class="badge kt-badge-purple">Na proveri</span>
                <span class="badge kt-badge-success">Završeno</span>
                <span class="badge kt-badge-secondary kt-strike">Otkazano</span>
                <span class="badge kt-badge-danger kt-pulse">Hitan</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                {% for size in [24, 32, 40, 64] %}
                    <span class="kt-avatar" data-tone="{{ loop.index0 }}" style="width: {{ size }}px; height: {{ size }}px; font-size: {{ (size * 0.38)|round }}px;">MP</span>
                {% endfor %}
                <span class="kt-avatar-stack">
                    {% for tone in 0..3 %}<span class="kt-avatar" data-tone="{{ tone * 2 }}" style="width: 32px; height: 32px; font-size: 12px;">A{{ tone }}</span>{% endfor %}
                    <span class="kt-avatar kt-more" style="width: 32px; height: 32px;">+3</span>
                </span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">{{ ui.stat_card('building-2', 128, 'Aktivnih klijenata', 'primary', null, 12.5) }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('circle-check', 54, 'Završeno ovog meseca', 'success', null, -4) }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('hourglass', 7, 'Čeka klijenta', 'warning', 'prosečno 4 dana') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('triangle-alert', 7, 'Kasni', 'danger', 'rok istekao') }}</div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Forme</h5></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3"><label class="form-label required">Naziv</label><input class="form-control" value="Firma d.o.o."><div class="form-text">Pomoćni tekst ispod polja</div></div>
                <div class="col-md-4 mb-3"><label class="form-label">PIB</label><input class="form-control kt-mono" value="100002119"></div>
                <div class="col-md-4 mb-3"><label class="form-label">Sa greškom</label><input class="form-control is-invalid" value="pogrešno"><div class="invalid-feedback">Unesi ispravnu vrednost.</div></div>
                <div class="col-md-4 mb-3"><label class="form-label">Izbor</label><select class="form-select"><option>Prva opcija</option><option>Druga opcija</option></select></div>
                <div class="col-md-4 mb-3"><label class="form-label">Checklist</label>
                    <div class="d-flex align-items-center gap-2 checklist-item mb-1"><input type="checkbox" class="form-check-input" checked><span class="checklist-text">Knjiženje izvoda</span></div>
                    <div class="d-flex align-items-center gap-2 checklist-item"><input type="checkbox" class="form-check-input"><span class="checklist-text">Provera faktura</span></div>
                </div>
                <div class="col-md-4 mb-3"><label class="form-label">Napredak</label><div class="d-flex align-items-center gap-3"><span class="kt-ring" style="--p: 62;"><span>5/8</span></span><div class="flex-fill kt-segments"><i class="done"></i><i class="done"></i><i></i></div></div></div>
            </div>
        </div>
    </div>

    {{ include('design/_controls.html.twig') }}

    <div class="card">
        <div class="card-header"><h5>Tabela</h5></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Klijent</th><th>Učesnici</th><th>Status</th><th class="text-end">Iznos</th><th style="width: 1%;"></th></tr></thead>
                <tbody>
                    <tr><td><div class="d-flex align-items-center gap-2"><span class="kt-avatar" data-tone="1" style="width: 32px; height: 32px; font-size: 12px;">PZ</span><div><div class="fw-medium">Pekara Zlatni klas</div><div class="kt-text-sm text-muted kt-mono">101000001</div></div></div></td>
                        <td><span class="kt-avatar-stack"><span class="kt-avatar" data-tone="0" style="width: 28px; height: 28px; font-size: 11px;">MP</span><span class="kt-avatar" data-tone="3" style="width: 28px; height: 28px; font-size: 11px;">JK</span></span></td>
                        <td><span class="badge kt-badge-primary">U radu</span></td><td class="text-end">16.000,00 RSD</td>
                        <td><button class="btn btn-ghost kt-btn-icon btn-sm">{{ ux_icon('lucide:pencil', {class: 'kt-icon'}) }}</button></td></tr>
                    <tr><td><div class="d-flex align-items-center gap-2"><span class="kt-avatar" data-tone="5" style="width: 32px; height: 32px; font-size: 12px;">AB</span><div><div class="fw-medium">Auto-servis Brzi</div><div class="kt-text-sm text-muted kt-mono">101000002</div></div></div></td>
                        <td><span class="kt-empty-value">—</span></td>
                        <td><span class="badge kt-badge-danger">{{ ux_icon('lucide:triangle-alert', {class: 'kt-icon'}) }} Kasni</span></td><td class="text-end">9.500,00 RSD</td>
                        <td>{# radnje u redu: tri tačke (meni se ne seče ni u poslednjem redu, assets/js/dropdowns.js) #}
                            <div class="dropdown">
                                <button type="button" class="btn btn-ghost kt-btn-icon btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Radnje">{{ ux_icon('lucide:ellipsis', {class: 'kt-icon'}) }}</button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" href="#">{{ ux_icon('lucide:pencil', {class: 'kt-icon me-2'}) }}Izmeni</a>
                                    <a class="dropdown-item" href="#">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Kreiraj zadatak</a>
                                    <div class="dropdown-divider"></div>
                                    <button type="button" class="dropdown-item text-danger">{{ ux_icon('lucide:trash-2', {class: 'kt-icon me-2'}) }}Obriši</button>
                                </div>
                            </div>
                        </td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100 mb-0"><div class="card-header"><h5>Prazno stanje</h5></div>{{ ui.empty_state('Još nema klijenata. Dodaj prvog da bi počeo.', 'building-2', 'Dodaj klijenta', '#') }}</div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card h-100 mb-0"><div class="card-header"><h5>Loader i skeleti</h5></div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">{{ ui.loader() }}{{ ui.loader(true) }}</div>
                    <div class="kt-skeleton mb-2" style="height: 16px; width: 60%;"></div>
                    <div class="kt-skeleton mb-2" style="height: 16px; width: 90%;"></div>
                    <div class="kt-skeleton" style="height: 48px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Timeline sa filterima i „Učitaj još“</h5></div>
        <div class="card-body">{{ tl.feed(path('ajax_user_activity', {id: app.user.id}), activity, true) }}</div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Godišnji kalendar neradnih dana</h5></div>
        <div class="card-body">
            <div class="kt-year" style="max-width: 220px;">
                <div class="kt-year-month">
                    <div class="kt-year-title">April 2026.</div>
                    <div class="kt-year-grid">
                        {% for n in ["P", "U", "S", "Č", "P", "S", "N"] %}<span class="kt-year-dow">{{ n }}</span>{% endfor %}
                        <span></span><span></span>
                        {% for d in 1..30 %}
                            {% set dow = (d + 1) % 7 + 1 %}
                            <span class="kt-year-day{% if d in [10, 11, 12, 13] %} is-holiday{% elseif dow >= 6 %} is-weekend{% endif %}{% if d == 22 %} is-today{% endif %}"{% if d in [10, 11, 12, 13] %} title="Uskršnji praznici" data-bs-toggle="tooltip"{% endif %}>{{ d }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Katalog: kategorije, raspored i checklist editor</h5></div>
        <div class="card-body">
            <div class="kt-overline mb-2">Badge kategorije</div>
            <div class="d-flex flex-wrap gap-2 mb-4">{% for c in categories %}{{ ui.category_badge(c) }}{% endfor %}</div>
            <p class="kt-text-sm text-muted mb-2">Značka pozicije zaposlenog (<code>ui.position_badge</code>): nivo, ne prava pristupa.</p>
            <div class="d-flex flex-wrap gap-2 mb-4">{% for p in positions %}{{ ui.position_badge(p) }}{% endfor %}</div>
            <p class="kt-text-sm text-muted mb-2">Značka provere zadatka (<code>task_review(task)</code>): ko proverava. Tri varijante: po poziciji (info), posebna potvrda (warning), bez provere (secondary).</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge kt-badge-info">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Proverava: šef tima</span>
                <span class="badge kt-badge-info">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Proverava: admin</span>
                <span class="badge kt-badge-warning">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Posebna potvrda: Ana Anić, zatražio: Petar Ilić</span>
                <span class="badge kt-badge-warning">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Posebna potvrda: Ana Anić (zahteva posao)</span>
                <span class="badge kt-badge-secondary">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Bez provere</span>
                <span class="badge kt-badge-secondary">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Bez provere, odlučio: Marko Marković</span>
            </div>
            <p class="kt-text-sm text-muted mb-2">Značka „Zatraži potvrdu“ u katalogu poslova i ugovorenim uslugama klijenta.</p>
            <div class="mb-4"><span class="kt-svc-name">Godišnji obračun <span class="badge kt-badge-warning ms-1" title="Zadatke iz ovog posla potvrđuje izabrana osoba">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Zatraži potvrdu</span></span></div>
            <p class="kt-text-sm text-muted mb-2">Polje „Provera“ iz forme zadatka (<code>reviewMode</code>) sa pomoćnim tekstom i izborom proveravača kad je „Posebna potvrda“.</p>
            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label" for="ds-review">Provera</label>
                    <select class="form-select" id="ds-review" data-native>
                        <option>Automatski, po poziciji</option>
                        <option>Bez provere</option>
                        <option selected>Posebna potvrda</option>
                    </select>
                    <div class="kt-text-sm text-muted mt-1">Zadatak potvrđuju samo izabrani admini; pozicija radnika se ne uzima u obzir.</div>
                    <label class="form-label mt-3" for="ds-approvers">Proveravači</label>
                    <select class="form-select" id="ds-approvers" multiple><option selected>Ana Anić</option><option>Marko Marković</option></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ds-review-locked">Provera (zaključano)</label>
                    <div class="kt-text-sm text-muted" id="ds-review-locked">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-1'}) }}Provera: Posebna potvrda: Ana Anić (zahteva posao)</div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-7">
                    <div class="kt-overline mb-2">Raspored (segmentirana dugmad i pregled rokova)</div>
                    {{ sf.fields(jobForm.schedule) }}
                </div>
                <div class="col-lg-5">
                    <div class="kt-overline mb-2">Checklist editor</div>
                    {{ ce.editor(jobForm.checklistItems) }}
                </div>
            </div>
            <div class="kt-overline mt-4 mb-2">Red posla klijenta: podrazumevani i prilagođeni raspored, ručno promenjen rok</div>
            <div class="row">
                <div class="col-lg-7">
                    <ul class="list-group">
                        <li class="list-group-item">
                            <div class="fw-semibold">PDV prijava</div>
                            <div class="kt-sched-row"><span class="text-muted">Podrazumevano: Mesečno, 3.</span> <button type="button" class="btn btn-link btn-sm p-0">Prilagodi za ovog klijenta</button></div>
                        </li>
                        <li class="list-group-item">
                            <div class="fw-semibold">Bilans stanja</div>
                            <div class="kt-sched-row is-customized"><span class="kt-badge kt-badge-info" title="Raspored za ovog klijenta">Prilagođeno: Mesečno, 6.</span> <button type="button" class="btn btn-link btn-sm p-0">Izmeni</button> <button type="button" class="btn btn-link btn-sm p-0">Vrati na podrazumevano</button></div>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-5 mt-3 mt-lg-0">
                    <div class="kt-text-sm">Rok zadatka: 17.03.2027. <span class="kt-due-manual text-muted ms-1" data-bs-toggle="tooltip" title="Rok ručno promenjen, podrazumevano je 3." aria-label="Rok ručno promenjen">{{ ux_icon('lucide:pencil-line', {class: 'kt-icon'}) }}</span></div>
                    <div class="kt-text-xs text-muted mt-1">Znak pencil-line stoji uz rok koji je ručno promenjen; tooltip kaže šta je podrazumevano.</div>
                </div>
            </div>
            <div class="kt-overline mt-4 mb-2">Filteri (mala segmentirana dugmad, čipovi-prekidači sa tačkom u boji)</div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="kt-segmented kt-segmented-sm" role="radiogroup" aria-label="Primer opsega">
                    {% for key, item in {a: ['Moji', 'user'], b: ['Moj tim', 'users'], c: ['Svi', 'building-2']} %}
                        <input type="radio" class="btn-check" name="design-scope" id="design-scope-{{ key }}" {{ loop.first ? 'checked' }} autocomplete="off">
                        <label class="btn" for="design-scope-{{ key }}">{{ ux_icon('lucide:' ~ item[1], {class: 'kt-icon'}) }}{{ item[0] }}</label>
                    {% endfor %}
                </div>
                <div class="d-flex flex-wrap gap-2">
                    {% for key, item in {t: ['Zadaci', 'primary', true], o: ['Odsustva', 'purple', true], n: ['Neradni dani', 'danger', false]} %}
                        <input type="checkbox" class="btn-check" id="design-chip-{{ key }}" {{ item[2] ? 'checked' }} autocomplete="off">
                        <label class="kt-chip" for="design-chip-{{ key }}" style="--kt-chip-dot: var(--kt-{{ item[1] }})"><span class="kt-chip-dot" aria-hidden="true"></span>{{ item[0] }}</label>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Uputstvo (tekst iz Markdown-a)</h5></div>
        <div class="card-body kt-help">
            <section class="kt-help-section">
                <h2 id="design-help">Primer poglavlja</h2>
                <p>Klikni <strong>Novi zadatak</strong>, pa upiši <strong>Naslov</strong>. Tastatura: <kbd>Enter</kbd>.</p>
                <figure class="kt-help-shot is-placeholder" role="img" aria-label="Slika: forma Novi zadatak"><span class="kt-help-shot-label">Slika</span><figcaption>forma Novi zadatak</figcaption></figure>
                <blockquote class="kt-help-note is-tip"><p><strong>Savet:</strong> zeleni okvir za korisne prečice.</p></blockquote>
                <blockquote class="kt-help-note is-warn"><p><strong>Pažnja:</strong> narandžasti okvir za stvari koje mogu da pođu naopako.</p></blockquote>
                <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Status</th><th>Značenje</th></tr></thead><tbody><tr><td><strong>Na proveri</strong></td><td>čeka potvrdu šefa</td></tr></tbody></table></div>
            </section>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Job picker (paketi, pojedinačni poslovi)</h5></div>
        <div class="card-body">{{ jp.picker('demo_jobs', [], null, 'design-picker') }}</div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Odsustva: stanje godišnjeg, zahtev na odobrenju, mesečni pregled</h5></div>
        <div class="card-body">
            <div class="kt-leave-strip mb-3">
                <div><span class="kt-overline">Godišnji odmor 2026.</span><strong class="fs-5">14</strong> <span class="text-muted">dana preostalo</span></div>
                <div class="kt-text-sm text-muted">pravo 20 · preneto 3 (do 30.6.) · iskorišćeno 9 · na odobrenju 2</div>
            </div>
            <div class="card kt-approval mb-3">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    {{ ui.avatar(app.user, 36) }}
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold">10.11.2026. – 13.11.2026. · 3 rad. dana</div>
                        <div class="mt-1"><span class="kt-cat-badge" style="--kt-cat: #0089FF;">{{ ux_icon('lucide:palmtree', {class: 'kt-icon'}) }}Godišnji odmor</span></div>
                    </div>
                    <div class="text-end"><div class="kt-text-sm text-warning">Automatski se odobrava za 1 d 6 h</div>
                        <div class="d-flex gap-1 justify-content-end mt-1"><button class="btn btn-sm btn-success">{{ ux_icon('lucide:badge-check', {class: 'kt-icon me-1'}) }}Odobri</button><button class="btn btn-sm btn-outline-danger">{{ ux_icon('lucide:x', {class: 'kt-icon me-1'}) }}Odbij</button></div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-sm kt-absence-grid mb-0">
                    <thead><tr><th class="kt-ag-name">Radnik</th>{% for d in 9..15 %}<th class="{{ d in [14, 15] ? 'is-off' }}">{{ d }}<span>{{ ['p', 'u', 's', 'č', 'p', 's', 'n'][d - 9] }}</span></th>{% endfor %}</tr></thead>
                    <tbody>
                        <tr><td class="kt-ag-name">{{ ui.avatar(app.user, 22) }} Primer odobreno</td>{% for d in 9..15 %}<td class="{{ d in [14, 15] ? 'is-off' }}">{% if d in [10, 11, 12] %}<span class="kt-ag-cell" style="--kt-cat: #0089FF;"></span>{% endif %}</td>{% endfor %}</tr>
                        <tr><td class="kt-ag-name">{{ ui.avatar(app.user, 22) }} Primer na odobrenju</td>{% for d in 9..15 %}<td class="{{ d in [14, 15] ? 'is-off' }}">{% if d in [12, 13] %}<span class="kt-ag-cell is-pending" style="--kt-cat: #8B5CF6;"></span>{% endif %}</td>{% endfor %}</tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                {% include 'absence/_team_availability.html.twig' with {availability: [
                    {user: app.user, available: true, periods: []},
                    {user: app.user, available: false, periods: [{from: date(), to: date('+3 days')}, {from: date('+14 days'), to: date('+14 days')}]},
                ]} %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Kalendar: naredna nedelja (dashboard)</h5></div>
        <div class="card-body">
            <div class="kt-week">
                {% for i in 0..6 %}
                    <div class="kt-week-day{{ i in [5, 6] ? ' is-off' }}{{ i == 0 ? ' is-today' }}">
                        <div class="kt-week-date">{{ ['pon', 'uto', 'sre', 'čet', 'pet', 'sub', 'ned'][i] }} {{ 9 + i }}.11.</div>
                        {% if i == 1 %}<span class="kt-week-item" style="--kt-cat: var(--kt-primary);">PDV prijava — Mlekara</span>{% endif %}
                        {% if i in [2, 3] %}<span class="kt-week-item" style="--kt-cat: #8B5CF6;">Marko · Slava</span>{% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Grafikon, potvrde i toast</h5></div>
        <div class="card-body">
            <div style="height: 220px;" class="mb-3">
                <canvas data-chart="{{ {
                    type: 'line',
                    data: {labels: ['Maj', 'Jun', 'Jul', 'Avg', 'Sep', 'Okt'], datasets: [{label: 'MRR (RSD)', data: [120000, 132000, 128000, 150000, 161000, 174000]}]},
                    options: {plugins: {legend: {display: false}}},
                }|json_encode|e('html_attr') }}"></canvas>
            </div>
            <form onsubmit="return false;" class="d-inline" {{ confirm_attrs('Primer potvrde', 'Ovako izgleda SweetAlert u aplikaciji.', 'warning', 'Da, nastavi') }}><button class="btn btn-outline-secondary">SweetAlert (upozorenje)</button></form>
            <form onsubmit="return false;" class="d-inline" {{ confirm_attrs('Primer opasne radnje', 'Crveno dugme samo kad je radnja glavna.', 'danger', 'Da, obriši', true) }}><button class="btn btn-outline-danger">SweetAlert (opasno + razlog)</button></form>
            <button class="btn btn-outline-secondary" onclick="window.ktToast('Izmene su sačuvane.', 'success')">Toast</button>
            <button class="btn btn-outline-secondary" onclick="window.ktToast('Klijent nije sačuvan: PIB već postoji.', 'danger')">Toast (greška)</button>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h5>Podsetnik: stavka, čipovi i panel</h5></div>
        <div class="card-body">
            <p class="kt-text-sm text-muted mb-2">Čipovi za rok i obaveštenje (<code>.kt-tchip</code>): izabrani je plav, "Izaberi…" otvara flatpickr sa vremenom.</p>
            <div class="kt-todo-chips mb-4">
                <button type="button" class="kt-tchip is-selected">Sutra 9:00</button>
                <button type="button" class="kt-tchip">Danas</button>
                <button type="button" class="kt-tchip">Ponedeljak 9:00</button>
                <button type="button" class="kt-tchip">{{ ux_icon('lucide:calendar-clock', {class: 'kt-icon me-1'}) }}Izaberi…</button>
                <span class="kt-tchip is-selected">13.11. 14:30<button type="button" class="kt-tchip-x" aria-label="Ukloni rok">{{ ux_icon('lucide:x', {class: 'kt-icon'}) }}</button></span>
            </div>
            <p class="kt-text-sm text-muted mb-2">Stavke liste (<code>templates/todo/_item.html.twig</code>): zakasnela, zakačena sa vezom i obaveštenjem, ponavljajuća i završena.</p>
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <div class="kt-todo-section is-danger"><div class="kt-todo-head">Zakasnelo (1)</div>
                        <div class="kt-todo-item"><div class="kt-todo-row"><input type="checkbox" class="kt-check" aria-label="Završi"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Poslati izvod klijentu</button><div class="kt-todo-meta"><span class="text-danger fw-semibold">{{ ux_icon('lucide:calendar', {class: 'kt-icon'}) }}Juče</span></div></div></div></div>
                    </div>
                    <div class="kt-todo-section"><div class="kt-todo-head">Danas (3)</div>
                        <div class="kt-todo-item is-pinned"><div class="kt-todo-row"><input type="checkbox" class="kt-check" aria-label="Završi"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Pozvati klijenta zbog PDV-a</button><div class="kt-todo-meta"><span>{{ ux_icon('lucide:calendar', {class: 'kt-icon'}) }}Danas 14:30</span><span>{{ ux_icon('lucide:bell', {class: 'kt-icon'}) }}Danas 14:30 {{ ux_icon('lucide:mail', {class: 'kt-icon'}) }}</span><span>{{ ux_icon('lucide:building-2', {class: 'kt-icon'}) }}<a href="#">Pekara Zlatni klas</a></span></div></div><button type="button" class="kt-icon-btn kt-todo-pin is-on" aria-label="Otkači">{{ ux_icon('lucide:pin', {class: 'kt-icon'}) }}</button></div></div>
                        <div class="kt-todo-item"><div class="kt-todo-row"><input type="checkbox" class="kt-check" aria-label="Završi"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Mesečni izveštaj</button><div class="kt-todo-meta"><span>{{ ux_icon('lucide:calendar', {class: 'kt-icon'}) }}Danas</span><span>{{ ux_icon('lucide:repeat', {class: 'kt-icon'}) }}Svakog meseca</span></div></div></div></div>
                        <div class="kt-todo-item is-done"><div class="kt-todo-row"><input type="checkbox" class="kt-check" checked aria-label="Vrati u rad"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Odgovoriti na mejl</button></div></div></div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <p class="kt-text-sm text-muted mb-2">Panel iz topbara (bočni offcanvas na računaru, bottom sheet na telefonu), skraćeno.</p>
                    <div class="border rounded p-3" style="background: var(--kt-surface);">
                        <div class="d-flex align-items-center mb-3"><strong>{{ ux_icon('lucide:notebook-pen', {class: 'kt-icon me-2'}) }}Podsetnik</strong><span class="kt-text-sm text-muted ms-auto">{{ ux_icon('lucide:lock', {class: 'kt-icon me-1'}) }}privatno</span></div>
                        <div class="kt-todo-toolbar"><button type="button" class="btn btn-primary kt-todo-new">{{ ux_icon('lucide:plus', {class: 'kt-icon me-1'}) }}Dodaj</button><span class="kt-text-sm text-muted">ili pritisni <kbd>n</kbd></span></div>
                        <div class="kt-todo-head">Bez roka (2)</div>
                        <div class="kt-todo-item"><div class="kt-todo-row"><input type="checkbox" class="kt-check" aria-label="Završi"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Srediti arhivu</button></div><span class="kt-todo-handle">{{ ux_icon('lucide:grip-vertical', {class: 'kt-icon'}) }}</span></div></div>
                        <div class="kt-todo-item"><div class="kt-todo-row"><input type="checkbox" class="kt-check" aria-label="Završi"><div class="kt-todo-main"><button type="button" class="kt-todo-title kt-check-label">Pročitati novi pravilnik</button></div><span class="kt-todo-handle">{{ ux_icon('lucide:grip-vertical', {class: 'kt-icon'}) }}</span></div></div>
                    </div>
                </div>
            </div>
            <p class="kt-text-sm text-muted mb-2">Početna: kartice su jedna ispod druge, svaka preko cele širine, na svim širinama (Podsetnik, Posebne potvrde, Naredna nedelja, Zadaci). Kartica Podsetnik prikazuje rok u istom redu sa naslovom stavke, a stavke se skrolaju unutar kartice posle ~8.</p>
            <p class="kt-text-sm text-muted mb-2">SweetAlert prozor za dodavanje i izmenu (isti za panel, stranu, karticu i taster <kbd>n</kbd>). Napredna polja su iza "Više opcija"; u izmeni postoji i crveno "Obriši".</p>
            <div class="swal2-popup kt-swal kt-todo-swal-popup mb-4" style="display: grid; position: static; width: min(460px, 100%);">
                <h2 class="swal2-title" style="display: block;">Izmena stavke</h2>
                <div class="swal2-html-container" style="display: block;">
                    <div class="kt-todo-dialog text-start">
                        <label class="form-label kt-text-sm">Naslov</label>
                        <input type="text" class="form-control mb-3" value="Pozvati klijenta zbog PDV-a">
                        <div class="row g-2">
                            <div class="col-7"><label class="form-label kt-text-sm">Rok</label><input type="text" class="form-control" value="13.11.2026."></div>
                            <div class="col-5"><label class="form-label kt-text-sm">Vreme</label><input type="time" class="form-control" value="14:30"></div>
                        </div>
                        <div class="kt-todo-chips mb-2"><button type="button" class="kt-tchip">Danas</button><button type="button" class="kt-tchip is-selected">Sutra</button><button type="button" class="kt-tchip">Ponedeljak</button></div>
                        <button type="button" class="btn btn-link btn-sm px-0" aria-expanded="false">Više opcija</button>
                    </div>
                </div>
                <div class="swal2-actions" style="display: flex;">
                    <button type="button" class="btn btn-primary">Sačuvaj</button>
                    <button type="button" class="btn btn-danger">Obriši</button>
                    <button type="button" class="btn btn-outline-secondary">Odustani</button>
                </div>
            </div>
            <p class="kt-text-sm text-muted mb-2">Toast obaveštenja sa dugmadima "Završeno" i "Odloži" i toast sa "Poništi" (5 s).</p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary" onclick="window.ktToast('Završeno.', 'success')">Toast sa "Poništi"</button>
                <span class="kt-text-sm text-muted align-self-center">Obaveštenje i "Poništi" se prikazuju kao SweetAlert toast (<code>reminderToast</code>, <code>undoToast</code> u <code>confirm.js</code>).</span>
            </div>
        </div>
    </div>
{% endblock %}