{#
    Timeline istorije izmena (ActivityLog), DESIGN.md 7.11: tanka vertikalna linija, mali krugovi u boji tipa akcije,
    rečenica sa korisnikom, relativno vreme (tačno u tooltipu) i izmene kao "staro → novo".
    Upotreba: {% import 'components/timeline.html.twig' as tl %}{{ tl.timeline(entries) }}
    show_target = true prikazuje i na šta se zapis odnosi (za timeline korisnika).
#}

{# Jedna promena polja: "Polje: staro → novo" #}
{% macro change(field, change) %}
    <div class="kt-tl-change">
        <span class="kt-tl-field">{{ field }}:</span>
        {% if change[0] is null %}
            {{ change[1] }}
        {% elseif change[1] is null %}
            <del>{{ change[0] }}</del> <span class="kt-tl-field">(uklonjeno)</span>
        {% else %}
            <del>{{ change[0] }}</del> {{ ux_icon('lucide:arrow-right', {class: 'kt-icon'}) }} {{ change[1] }}
        {% endif %}
    </div>
{% endmacro %}

{% macro target(entry) %}
    {% if entry.entityType == 'Task' %}
        <a href="{{ path('task_show', {id: entry.entityId}) }}">{{ entry.entityLabel ?? 'Zadatak' }}</a>
    {% elseif entry.entityType == 'Client' %}
        <a href="{{ path('client_show', {id: entry.entityId}) }}">{{ entry.entityLabel ?? 'Klijent' }}</a>
    {% else %}
        {{ entry.entityLabel ?? 'Korisnik' }}
    {% endif %}
{% endmacro %}

{% macro timeline(entries, show_target = false) %}
    {% import _self as tl %}
    {% import 'components/ui.html.twig' as ui %}
    {% if entries is empty %}
        {{ ui.empty_state('Još nema zabeleženih izmena.', 'history') }}
    {% else %}
        <ol class="kt-timeline">
            {% set day = null %}
            {% for entry in entries %}
                {% set entry_day = entry.createdAt|date('Y-m-d') %}
                {% if entry_day != day %}
                    {% set day = entry_day %}
                    <li class="kt-tl-day">{{ entry.createdAt|date('d.m.Y.') }}</li>
                {% endif %}
                <li class="kt-tl-item">
                    <span class="kt-tl-dot kt-tl-dot--{{ entry.action.color }}">{{ ux_icon('lucide:' ~ entry.action.icon, {class: 'kt-icon'}) }}</span>
                    <div class="kt-tl-body">
                        <div class="kt-tl-head">
                            {% if entry.user %}{{ ui.avatar(entry.user, 24) }}{% endif %}
                            <span><strong>{{ entry.user ? entry.user.fullName : 'Sistem' }}</strong> · {{ entry.action.label|lower }}{% if show_target %} · {{ tl.target(entry) }}{% endif %}</span>
                            <time class="kt-tl-time" datetime="{{ entry.createdAt|date('c') }}" title="{{ entry.createdAt|date('d.m.Y. H:i') }}">{{ entry.createdAt|date('H:i') }}</time>
                        </div>
                        {% for field, change in entry.changes %}
                            {{ tl.change(field, change) }}
                        {% endfor %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endmacro %}
