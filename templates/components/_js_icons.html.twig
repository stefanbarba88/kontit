{# Ikonice za HTML koji pravi JavaScript (assets/js/icons.js, icon('naziv')). Dodaj novu ovde pa pokreni ux:icons:lock. #}
<template id="kt-js-icons">
    {% for name in ['eye', 'search', 'x', 'filter', 'grip-vertical', 'circle', 'play', 'hourglass', 'circle-check-big', 'triangle-alert', 'clock-alert'] %}<span data-icon="{{ name }}">{{ ux_icon('lucide:' ~ name, {class: 'kt-icon'}) }}</span>{% endfor %}
</template>
