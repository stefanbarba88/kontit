{#
    Mali UI makroi po DESIGN.md (badge-ovi, avatari, KPI, prazna stanja, loader).
    Upotreba: {% import 'components/ui.html.twig' as ui %}
    Veličine avatara: 24, 32, 40, 64, 96px.
#}

{# Avatar (DESIGN.md 7.9): samo inicijali na gradijentu; boja se bira iz imena, pa je ista osoba uvek iste boje #}
{% macro avatar(user, size = 32, extra_class = '') %}
    <span class="kt-avatar {{ extra_class }}" data-tone="{{ user.avatarTone }}" style="width: {{ size }}px; height: {{ size }}px; font-size: {{ (size * 0.38)|round }}px;">{{ user.initials }}</span>
{% endmacro %}

{% macro user_chip(user, size = 32) %}
    {% import _self as ui %}
    <span class="d-inline-flex align-items-center">{{ ui.avatar(user, size, 'me-2') }}<span>{{ user.fullName }}</span></span>
{% endmacro %}

{# Badge tima: boja iz baze se zadaje inline #}
{% macro team_badge(team) %}
    <span class="badge badge-team" style="background-color: {{ team.color }};">{{ team.name }}</span>
{% endmacro %}

{# Badge kategorije posla (SPEC 8g.1): meka pozadina u boji kategorije, opciona ikonica #}
{% macro category_badge(category) %}
    {% if category %}<span class="kt-cat-badge{{ category.active ? '' : ' is-inactive' }}" style="--kt-cat: {{ category.color }};">{% if category.icon %}{{ ux_icon('lucide:' ~ category.icon, {class: 'kt-icon'}) }}{% endif %}{{ category.name }}</span>{% endif %}
{% endmacro %}

{% macro position_badge(position) %}
    {% if position %}<span class="kt-cat-badge{{ position.active ? '' : ' is-inactive' }}" style="--kt-cat: {{ position.color }};">{{ position.name }}</span>{% endif %}
{% endmacro %}

{% macro role_badge(role) %}
    {% set cls = {
        'ROLE_SUPERADMIN': 'danger',
        'ROLE_ADMIN': 'warning',
        'ROLE_SEF': 'info',
        'ROLE_RADNIK': 'secondary',
    } %}
    <span class="badge kt-badge-{{ cls[role.value] }}">{{ role.label }}</span>
{% endmacro %}

{% macro status_badge(active) %}
    {% if active %}
        <span class="badge kt-badge-success">Aktivan</span>
    {% else %}
        <span class="badge kt-badge-secondary">Neaktivan</span>
    {% endif %}
{% endmacro %}

{# Kartica klijenta. mode: 'primary' (puna) ili 'backup' (isprekidana ivica, badge ZAMENA) #}
{# absence: odobreno odsustvo glavnog zaduženog koje danas traje (aktivna zamena) #}
{% macro client_card(client, mode = 'primary', absence = null) %}
    <div data-kt-client-card class="card h-100 mb-0 {{ mode == 'backup' ? (absence ? 'border-info' : 'border-dashed border-secondary bg-light') : '' }}">
        <div class="card-body">
            <div class="d-flex align-items-start mb-2">
                <h6 class="mb-0"><a href="{{ path('client_show', {id: client.id}) }}" class="text-body fw-semibold stretched-link">{{ client.shortName }}</a></h6>
                {% if mode == 'backup' %}<span class="badge {{ absence ? 'bg-info' : 'bg-secondary' }} ms-auto">{{ absence ? 'AKTIVNA ZAMENA' : 'ZAMENA' }}</span>{% endif %}
            </div>
            <div class="text-muted mb-2">
                {% if client.pib %}PIB {{ client.pib }}{% endif %}{% if client.pdvObveznik %}{{ client.pib ? ' · ' }}PDV{% endif %}
            </div>
            {% if mode == 'backup' %}
                <div class="kt-text-sm">{{ ux_icon('lucide:circle-user', {class: 'kt-icon me-1'}) }}Glavni zaduženi: <span class="fw-semibold">{{ client.primaryAccountant.fullName }}</span></div>
                {% if absence %}
                    <div class="kt-text-sm text-info mt-1">{{ ux_icon('lucide:plane', {class: 'kt-icon me-1'}) }}Nije dostupan do {{ absence.endDate|date('d.m.Y.') }} · preuzimaš</div>
                {% endif %}
            {% elseif client.backupAccountant %}
                <div class="kt-text-sm text-muted">{{ ux_icon('lucide:refresh-cw', {class: 'kt-icon me-1'}) }}Backup: {{ client.backupAccountant.fullName }}</div>
            {% else %}
                <div class="kt-text-sm text-warning">{{ ux_icon('lucide:triangle-alert', {class: 'kt-icon me-1'}) }}Bez backup-a</div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{# Badge-ovi zadatka (3.5): meka pozadina + tačkica; OTKAZANO precrtan #}
{% macro task_status(status) %}
    <span class="badge kt-badge-{{ status.color }} {{ status.value == 'OTKAZANO' ? 'kt-strike' : '' }}">{{ status.label }}</span>
{% endmacro %}

{% macro priority_badge(priority) %}
    <span class="badge kt-badge-{{ priority.color }} {{ priority.value == 'HITAN' ? 'kt-pulse' : (priority.value == 'NORMALAN' ? 'kt-badge-outline' : '') }}">{{ priority.label }}</span>
{% endmacro %}

{% macro assignee_status(status) %}
    <span class="badge kt-badge-{{ status.color }}">{{ status.label }}</span>
{% endmacro %}

{# Rok zadatka: crveno ako kasni #}
{% macro due_date(task) %}
    {% if task.dueDate %}
        <span class="{{ task.overdue ? 'text-danger fw-semibold' : '' }}">
            {% if task.overdue %}{{ ux_icon('lucide:triangle-alert', {class: 'kt-icon me-1'}) }}{% endif %}{{ task.dueDate|date('d.m.Y.') }}
        </span>
        {% if task.dueDateManuallySet %}
            {% set default_due = task_default_due(task) %}
            {# ručno promenjen rok (SPEC 8g.5): generator i izmena rasporeda ga ne diraju #}
            <span class="kt-due-manual text-muted ms-1" data-bs-toggle="tooltip" title="Rok ručno promenjen{{ default_due ? ', podrazumevano je ' ~ (default_due|date('Y-m') == task.dueDate|date('Y-m') ? default_due|date('j') ~ '.' : default_due|date('d.m.Y.')) }}" aria-label="Rok ručno promenjen">{{ ux_icon('lucide:pencil-line', {class: 'kt-icon'}) }}</span>
        {% endif %}
    {% else %}
        <span class="text-muted">—</span>
    {% endif %}
{% endmacro %}

{# Prazno stanje (7.12): linijski znak, naslov/tekst i opciono jedno dugme #}
{% macro empty_state(text, icon = 'inbox', action_label = null, action_url = null) %}
    <div class="kt-empty">
        <svg class="kt-empty-mark" viewBox="0 0 68 68" aria-hidden="true"><circle cx="34" cy="19" r="7"/><circle cx="18.5" cy="34" r="7"/><circle cx="48.7" cy="34" r="7"/><circle cx="34" cy="49" r="7"/></svg>
        <p>{{ text }}</p>
        {% if action_label and action_url %}<a href="{{ action_url }}" class="btn btn-primary">{{ action_label }}</a>{% endif %}
    </div>
{% endmacro %}

{# KPI kartica (7.4): labela, krupan broj (broji se pri učitavanju), opciona promena i napomena.
   tone: primary | success | warning | danger | info; za warning/danger kartica dobija traku na vrhu.
   value može biti broj (animira se) ili tekst; delta je procenat promene ili null. #}
{% macro stat_card(icon, value, label, color = 'primary', hint = null, delta = null) %}
    <div class="card kt-kpi {{ color in ['danger', 'warning'] ? 'kt-kpi--' ~ color : '' }}">
        <div class="card-body">
            <div class="d-flex align-items-start justify-content-between mb-2">
                <span class="kt-kpi-label">{{ label }}</span>
                <span class="kt-kpi-icon" style="background: var(--kt-{{ color == 'primary' or color == 'info' ? 'primary' : color }}-soft, var(--kt-primary-soft)); color: var(--kt-{{ color == 'info' ? 'primary' : color }}, var(--kt-primary));">{{ ux_icon('lucide:' ~ icon, {class: 'kt-icon'}) }}</span>
            </div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="kt-kpi-value">{% if (value ~ '') matches '/^\d+$/' %}<span data-countup="{{ value }}">{{ value|number_format(0, ',', '.') }}</span>{% else %}{{ value }}{% endif %}</span>
                {% if delta is not null %}<span class="kt-delta {{ delta >= 0 ? 'kt-delta--up' : 'kt-delta--down' }}">{{ ux_icon(delta >= 0 ? 'lucide:trending-up' : 'lucide:trending-down', {class: 'kt-icon'}) }} {{ delta|abs|number_format(1, ',') }}%</span>{% endif %}
            </div>
            {% if hint %}<div class="kt-kpi-hint mt-1">{{ hint }}</div>{% endif %}
        </div>
    </div>
{% endmacro %}


{# Složeni (preklopljeni) avatari, "+N" za ostale (7.5) #}
{% macro avatar_stack(users, size = 28, max = 4) %}
    {% import _self as ui %}
    <span class="kt-avatar-stack">
        {% for u in users|slice(0, max) %}{{ ui.avatar(u, size) }}{% endfor %}
        {% if users|length > max %}<span class="kt-avatar kt-more" style="width: {{ size }}px; height: {{ size }}px;">+{{ users|length - max }}</span>{% endif %}
    </span>
{% endmacro %}

{# Loader brenda (7.13) #}
{% macro loader(small = false) %}
    <span class="kt-loader {{ small ? 'kt-loader--sm' : '' }}" role="status" aria-label="Učitavanje"><i></i><i></i><i></i><i></i></span>
{% endmacro %}