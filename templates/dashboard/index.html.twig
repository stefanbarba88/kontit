{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Početna{% endblock %}
{% block page_title %}Početna{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Početna</span>{% endblock %}

{% macro pct(value) %}{{ value is null ? '—' : value ~ '%' }}{% endmacro %}

{% block content %}
    {# Raspored (lg+): admin 6/12 Zadaci + Kalendar, 3/12 Podsetnik, 3/12 Posebne potvrde; šef i radnik 9/12 + 3/12 Podsetnik.
       Redosled blokova u DOM-u je redosled na telefonu (Zadaci, Podsetnik, Kalendar, Posebne potvrde); od lg ih raspoređuje CSS grid (assets/styles/components/dashboard.css). #}
    <div class="kt-dash{{ special is not null ? (admin ? ' kt-dash--wide' : ' kt-dash--special') : '' }}">
        <section class="kt-dash-tasks" aria-labelledby="kt-dash-tasks-title">
            <h5 class="mb-3" id="kt-dash-tasks-title">{{ ux_icon('lucide:list-checks', {class: 'kt-icon me-2'}) }}Zadaci</h5>
            <div class="kt-dash-stats">
                {{ ui.stat_card('list-checks', me.open, 'Otvoreni zadaci', 'primary') }}
                {{ ui.stat_card('circle-alert', me.overdue, 'Kasne', me.overdue > 0 ? 'danger' : 'success') }}
                {{ ui.stat_card('clock', me.dueSoon, 'Ističu u 3 dana', me.dueSoon > 0 ? 'warning' : 'secondary') }}
                {{ ui.stat_card('circle-check', me.doneThisMonth, 'Završeno ovog meseca', 'success', 'Prošli mesec: ' ~ me.doneLastMonth) }}
                {{ ui.stat_card('timer', _self.pct(me.onTimePercent), 'Završeno na vreme', 'info', 'poslednjih 90 dana') }}
                {{ ui.stat_card('undo-2', me.returned30, 'Vraćeno na doradu', me.returned30 > 0 ? 'warning' : 'secondary', 'poslednjih 30 dana') }}
                {{ ui.stat_card('building-2', me.clientsPrimary, 'Klijenti (glavni)', 'primary') }}
                {{ ui.stat_card('refresh-cw', me.clientsBackup, 'Klijenti (backup)', 'secondary') }}
            </div>
        </section>

        {# Podsetnik: uska kolona, naslov i "+ Dodaj" u zaglavlju, stavke preko cele širine, unutrašnji skrol; osvežava se kroz assets/js/todo.js #}
        <section class="kt-dash-todo" aria-label="Podsetnik">
            <div class="card kt-todo-card mb-0">
                <div class="card-header d-flex align-items-center gap-2">
                    <h5 class="mb-0">{{ ux_icon('lucide:notebook-pen', {class: 'kt-icon me-2'}) }}Podsetnik</h5>
                    <button type="button" class="btn btn-primary btn-sm kt-todo-new ms-auto" data-todo-new>{{ ux_icon('lucide:plus', {class: 'kt-icon me-1'}) }}Dodaj</button>
                </div>
                <div class="card-body border-top py-2 kt-dash-todo-body">
                    {% include 'todo/_body.html.twig' with {sections: todoSections, found: [], query: '', add: false} only %}
                </div>
                <div class="card-footer py-2"><a href="{{ path('todo_index') }}" class="kt-text-sm">Otvori ceo podsetnik{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a></div>
            </div>
        </section>

        {# mali pregled naredne nedelje (SPEC 8n) #}
        <section class="kt-dash-calendar" aria-label="Kalendar">
            <div class="card mb-0">
                <div class="card-header d-flex align-items-center"><h5 class="mb-0">{{ ux_icon('lucide:calendar-days', {class: 'kt-icon me-2'}) }}Naredna nedelja</h5><a href="{{ path('calendar_index') }}" class="btn btn-ghost btn-sm ms-auto">Kalendar{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a></div>
                <div class="card-body border-top">
                    <div class="kt-week">
                        {% for day in week %}
                            <div class="kt-week-day{{ day.off ? ' is-off' }}{{ day.date|date('Y-m-d') == 'now'|date('Y-m-d') ? ' is-today' }}">
                                <div class="kt-week-date">{{ ['', 'pon', 'uto', 'sre', 'čet', 'pet', 'sub', 'ned'][day.date|date('N')] }} {{ day.date|date('j.n.') }}{% if day.off and day.off not in ['Subota', 'Nedelja'] %} <span class="text-danger">· {{ day.off }}</span>{% endif %}</div>
                                {% for item in day.items|slice(0, 4) %}
                                    {% if item.url %}<a href="{{ item.url }}" class="kt-week-item" style="--kt-cat: {{ item.color }};" title="{{ item.title }} · {{ item.meta }}">{{ item.title }}</a>
                                    {% else %}<span class="kt-week-item" style="--kt-cat: {{ item.color }};" title="{{ item.meta }}">{{ item.title }}</span>{% endif %}
                                {% endfor %}
                                {% if day.items|length > 4 %}<div class="kt-text-xs text-muted">+ još {{ day.items|length - 4 }}</div>{% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>

        {% if special is not null %}
            {# uska kolona: brojač i kratka lista, cela lista je na strani posebnih potvrda #}
            <section class="kt-dash-special" aria-label="Zadaci sa posebnom potvrdom">
                <div class="card mb-0">
                    <div class="card-header d-flex align-items-center gap-2">
                        <h5 class="mb-0">{{ ux_icon('lucide:shield-check', {class: 'kt-icon me-2'}) }}Posebne potvrde</h5>
                        <span class="badge bg-{{ special.count ? (special.overdue ? 'danger' : 'warning') : 'secondary' }} ms-auto">{{ special.count }}</span>
                    </div>
                    {% if special.count %}
                        <ul class="list-group list-group-flush border-top">
                            {% for t in special.items %}
                                <li class="list-group-item"><a href="{{ path('task_show', {id: t.id}) }}">{{ t.title }}</a>
                                    <div class="kt-text-sm text-muted">{{ t.client ? t.client.shortName : 'Interni' }}{% if t.submittedAt %} · poslato {{ t.submittedAt|date('d.m.') }}{% endif %}</div></li>
                            {% endfor %}
                        </ul>
                        <div class="card-footer py-2 d-flex align-items-center gap-2">
                            <span class="kt-text-sm {{ special.overdue ? 'text-danger' : 'text-muted' }}">Najstariji od {{ special.oldest|date('d.m.Y.') }}</span>
                            <a href="{{ path('special_approvals_index') }}" class="btn btn-primary btn-sm ms-auto">Pregledaj{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a>
                        </div>
                    {% else %}
                        <div class="card-body border-top kt-text-sm text-muted">Nema posebnih potvrda.</div>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </div>

    {% if showTeam %}
        <h5 class="mb-3">{{ ux_icon('lucide:users', {class: 'kt-icon me-2'}) }}{{ admin ? 'Svi radnici' : 'Moj tim' }}</h5>
        {% if team.workers %}
            <div class="row mb-3">
                <div class="col-lg-7 mb-3">
                    <div class="card h-100 mb-0">
                        <div class="card-header"><h6 class="mb-0">Opterećenje po radniku</h6></div>
                        <div class="card-body" style="height: 300px;">
                            <canvas data-chart="{{ {
                                type: 'bar',
                                data: {
                                    labels: team.workers|map(w => w.name),
                                    datasets: [
                                        {label: 'Klijenti', data: team.workers|map(w => w.clients), backgroundColor: '#5c6bc0'},
                                        {label: 'Otvoreni zadaci', data: team.workers|map(w => w.open), backgroundColor: '#26a69a'},
                                        {label: 'Kasne', data: team.workers|map(w => w.overdue), backgroundColor: '#ef5350'},
                                    ],
                                },
                                options: {scales: {y: {beginAtZero: true, ticks: {precision: 0}}}},
                            }|json_encode|e('html_attr') }}"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 mb-3">
                    <div class="row h-100">
                        <div class="col-6 mb-3">{{ ui.stat_card('hourglass', team.awaiting|length, 'Čeka potvrdu', team.awaiting ? 'warning' : 'secondary', team.awaiting ? 'najstariji od ' ~ team.awaiting[0].submitted_at|date('d.m.') : null) }}</div>
                        <div class="col-6 mb-3">{{ ui.stat_card('calendar-check', team.avgDaysToApproval is null ? '—' : team.avgDaysToApproval ~ ' d', 'Od kreiranja do potvrde', 'info', 'prosek, 90 dana') }}</div>
                        <div class="col-12">
                            <div class="card h-100 mb-0">
                                <div class="card-header"><h6 class="mb-0">Čeka klijenta duže od {{ waitingDays }} dana</h6></div>
                                <ul class="list-group list-group-flush border-top">
                                    {% for t in team.waiting %}
                                        <li class="list-group-item"><a href="{{ path('task_show', {id: t.id}) }}">{{ t.title }}</a>
                                            <span class="text-muted kt-text-sm">{{ t.client ?: 'Interni' }} · od {{ t.updated_at|date('d.m.') }}</span></li>
                                    {% else %}
                                        <li class="list-group-item text-muted">Nema takvih zadataka.</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h6 class="mb-0">Učinak po radniku</h6></div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr><th>Radnik</th><th class="text-center">Klijenti</th><th class="text-center">Otvoreni</th><th class="text-center">Kasne</th>
                                <th class="text-center">Na vreme 30 d</th><th class="text-center">Na vreme 90 d</th><th class="text-center">Vraćeno 30 d</th><th class="text-center">Vraćeno 90 d</th></tr>
                        </thead>
                        <tbody>
                            {% for w in team.workers|sort((a, b) => b.overdue <=> a.overdue) %}
                                <tr>
                                    <td><a href="{{ path('task_index', {scope: 'all', user: w.id}) }}">{{ w.name }}</a></td>
                                    <td class="text-center">{{ w.clients }}</td>
                                    <td class="text-center"><a href="{{ path('task_index', {scope: 'all', user: w.id}) }}">{{ w.open }}</a></td>
                                    <td class="text-center {{ w.overdue ? 'text-danger fw-semibold' : '' }}">{% if w.overdue %}<a class="text-danger" href="{{ path('task_index', {tab: 'overdue', scope: 'all', user: w.id}) }}">{{ w.overdue }}</a>{% else %}0{% endif %}</td>
                                    <td class="text-center">{{ _self.pct(w.onTime30) }}</td>
                                    <td class="text-center">{{ _self.pct(w.onTime90) }}</td>
                                    <td class="text-center">{{ _self.pct(w.returned30) }}</td>
                                    <td class="text-center">{{ _self.pct(w.returned90) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted kt-text-sm">Na vreme: završeno do roka (zadaci sa rokom). Vraćeno: vraćanja na doradu u odnosu na broj završenih. Radnici sa najviše kašnjenja su na vrhu.</div>
            </div>
        {% else %}
            <div class="card"><div class="card-body">{{ ui.empty_state('Nemaš radnike u timu.', 'users') }}</div></div>
        {% endif %}
    {% endif %}

    {% if admin %}
        <h5 class="mb-3 mt-4">{{ ux_icon('lucide:chart-column', {class: 'kt-icon me-2'}) }}Cela firma</h5>

        <div class="card">
            <div class="card-header"><h6 class="mb-0">Po timovima</h6></div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Tim</th><th>Šef</th><th class="text-center">Radnika</th><th class="text-center">Klijenti</th><th class="text-center">Otvoreni</th><th class="text-center">Kasne</th><th class="text-center">Čeka potvrdu</th><th class="text-center">Prosek do potvrde</th><th class="text-center">Na vreme 30 d</th></tr></thead>
                    <tbody>
                        {% for t in teams %}
                            <tr>
                                <td><span class="badge badge-team" style="background-color: {{ t.color }};">{{ t.name }}</span></td>
                                <td>{{ t.leader ?: '—' }}</td>
                                <td class="text-center">{{ t.members }}</td>
                                <td class="text-center">{{ t.clients }}</td>
                                <td class="text-center">{{ t.open }}</td>
                                <td class="text-center {{ t.overdue ? 'text-danger fw-semibold' : '' }}">{{ t.overdue }}</td>
                                <td class="text-center">{{ t.awaiting }}</td>
                                <td class="text-center">{{ t.avgDays is null ? '—' : t.avgDays ~ ' d' }}</td>
                                <td class="text-center">{{ _self.pct(t.onTime30) }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9">{{ ui.empty_state('Nema timova.', 'users') }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if noReview %}
            <div class="card mt-3">
                <div class="card-header"><h6 class="mb-0">{{ ux_icon('lucide:shield-off', {class: 'kt-icon me-2'}) }}Zadaci „Bez provere“ po odlučivaču <span class="text-muted kt-text-sm">(90 dana)</span></h6></div>
                <ul class="list-group list-group-flush">
                    {% for r in noReview %}<li class="list-group-item d-flex justify-content-between"><span>{{ r.name }}</span><span class="fw-semibold">{{ r.n }}</span></li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="row">
            <div class="col-lg-7 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-header"><h6 class="mb-0">Završeni zadaci po mesecima</h6></div>
                    <div class="card-body" style="height: 280px;">
                        <canvas data-chart="{{ {
                            type: 'line',
                            data: {labels: company.trend|map(r => r.label), datasets: [{label: 'Završeno', data: company.trend|map(r => r.n), borderColor: '#26a69a', backgroundColor: 'rgba(38,166,154,.15)', fill: true, tension: 0.3}]},
                            options: {plugins: {legend: {display: false}}, scales: {y: {beginAtZero: true, ticks: {precision: 0}}}},
                        }|json_encode|e('html_attr') }}"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-header"><h6 class="mb-0">Klijenti po timu</h6></div>
                    <div class="card-body" style="height: 280px;">
                        <canvas data-chart="{{ {
                            type: 'doughnut',
                            data: {labels: company.clientsPerTeam|map(r => r.label), datasets: [{data: company.clientsPerTeam|map(r => r.n), backgroundColor: ['#5c6bc0', '#26a69a', '#ffa726', '#ef5350', '#42a5f5', '#8d6e63', '#9ccc65', '#ab47bc']}]},
                            options: {plugins: {legend: {position: 'right'}}},
                        }|json_encode|e('html_attr') }}"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-header"><h6 class="mb-0">Klijenti po radniku</h6></div>
                    <div class="card-body" style="height: {{ 60 + company.clientsPerWorker|length * 28 }}px; min-height: 200px;">
                        <canvas data-chart="{{ {
                            type: 'bar',
                            data: {labels: company.clientsPerWorker|map(r => r.label), datasets: [{label: 'Klijenti (glavni)', data: company.clientsPerWorker|map(r => r.n), backgroundColor: '#5c6bc0'}]},
                            options: {indexAxis: 'y', plugins: {legend: {display: false}}, scales: {x: {beginAtZero: true, ticks: {precision: 0}}}},
                        }|json_encode|e('html_attr') }}"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="card mb-3">
                    <div class="card-header"><h6 class="mb-0">{{ ux_icon('lucide:triangle-alert', {class: 'kt-icon text-warning me-2'}) }}Klijenti bez backup radnika <span class="badge bg-warning rounded-pill ms-1">{{ company.noBackup|length }}</span></h6></div>
                    <ul class="list-group list-group-flush border-top overflow-auto" style="max-height: 180px;">
                        {% for c in company.noBackup %}
                            <li class="list-group-item"><a href="{{ path('client_show', {id: c.id}) }}">{{ c.name }}</a> <span class="text-muted kt-text-sm">· {{ c.worker }}</span></li>
                        {% else %}
                            <li class="list-group-item text-muted">Svi klijenti imaju backup.</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="card mb-0">
                    <div class="card-header"><h6 class="mb-0">{{ ux_icon('lucide:moon', {class: 'kt-icon me-2'}) }}Klijenti bez zadatka u 30 dana <span class="badge bg-secondary rounded-pill ms-1">{{ company.idleClients|length }}</span></h6></div>
                    <ul class="list-group list-group-flush border-top overflow-auto" style="max-height: 180px;">
                        {% for c in company.idleClients %}
                            <li class="list-group-item"><a href="{{ path('client_show', {id: c.id}) }}">{{ c.name }}</a> <span class="text-muted kt-text-sm">· {{ c.worker }}</span></li>
                        {% else %}
                            <li class="list-group-item text-muted">Svaki klijent ima bar jedan zadatak.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-header"><h6 class="mb-0">Najaktivniji (30 dana, po istoriji izmena)</h6></div>
                    <ul class="list-group list-group-flush border-top">
                        {% for u in company.mostActive %}<li class="list-group-item d-flex">{{ u.name }}<span class="ms-auto text-muted">{{ u.n }}</span></li>{% endfor %}
                    </ul>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card h-100 mb-0">
                    <div class="card-header"><h6 class="mb-0">Najmanje aktivni (30 dana)</h6></div>
                    <ul class="list-group list-group-flush border-top">
                        {% for u in company.leastActive %}<li class="list-group-item d-flex">{{ u.name }}<span class="ms-auto text-muted">{{ u.n }}</span></li>{% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
