<!DOCTYPE html>
<html lang="sr" dir="ltr" data-bs-theme="light" data-kt-pref="{{ app.user ? app.user.themePreference.value|lower : 'system' }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="theme-color" content="#F5F6F8" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#0B0F14" media="(prefers-color-scheme: dark)">
	{% if app.user %}<meta name="csrf-token" content="{{ csrf_token('ajax') }}">
	<meta name="kt-non-working-url" content="{{ path('ajax_calendar_non_working') }}">{% endif %}
	<title>{% block title %}Početna{% endblock %} · KontIT app</title>
	{{ include('_head_theme.html.twig') }}
	{{ include('_favicons.html.twig') }}
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-title" content="KontIT">
	<meta name="apple-mobile-web-app-status-bar-style" content="default">

	{% block stylesheets %}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@600;700;800&display=swap&subset=latin-ext" rel="stylesheet">
	{% endblock %}

	{% block javascripts %}
		{% block importmap %}{{ importmap('app') }}{% endblock %}
	{% endblock %}
</head>
<body class="kt-app" data-route="{{ app.request.attributes.get('_route')|default('') }}">
{% import 'components/ui.html.twig' as ui %}
{% import 'components/nav.html.twig' as nav %}
{% set route = app.request.attributes.get('_route')|default('') %}

<div class="kt-shell">

	<aside class="kt-sidebar" id="kt-sidebar" aria-label="Glavni meni">
		<div class="kt-sidebar-brand">
			<a href="{{ path('app_dashboard') }}" class="kt-brand-link" aria-label="KontIT app">
				{{ include('components/_logo.html.twig') }}
				{{ include('components/_logo_mark.html.twig') }}
			</a>
			<button type="button" class="kt-icon-btn kt-sidebar-collapse d-none d-lg-inline-flex" data-kt-sidebar-collapse title="Skupi meni" aria-label="Skupi meni">
				{{ ux_icon('lucide:panel-left', {class: 'kt-icon'}) }}
			</button>
			<button type="button" class="kt-icon-btn d-lg-none" data-kt-sidebar-close aria-label="Zatvori meni">
				{{ ux_icon('lucide:x', {class: 'kt-icon'}) }}
			</button>
		</div>

		<nav class="kt-nav">
			{{ nav.group('Rad') }}
			{{ nav.link(path('app_dashboard'), 'house', 'Početna', route == 'app_dashboard') }}
			{{ nav.link(path('client_mine'), 'briefcase', 'Moji klijenti', route == 'client_mine') }}
			{{ nav.link(path('absence_index'), 'plane', 'Odsustva', route starts with 'absence_', pending_absence_count()) }}
			{{ nav.link(path('task_index'), 'list-checks', 'Zadaci', route starts with 'task_', awaiting_approval_count()) }}
			{% if is_granted('SPECIAL_APPROVALS_VIEW') %}{{ nav.link(path('special_approvals_index'), 'shield-check', 'Posebne potvrde', route starts with 'special_approvals', special_approval_count()) }}{% endif %}
			{{ nav.link(path('calendar_index'), 'calendar-days', 'Kalendar', route starts with 'calendar_') }}

			{% if is_granted('ROLE_SEF') %}
				{{ nav.group('Klijenti') }}
				{{ nav.link(path('client_index'), 'building-2', 'Klijenti', route starts with 'client_' and route != 'client_mine') }}
				{% if is_granted('TEAM_MANAGE') %}
					{{ nav.link(path('admin_team_index'), 'users', 'Timovi', route starts with 'admin_team' or route == 'team_show') }}
				{% else %}
					{{ nav.link(path('my_team'), 'users', 'Moj tim', route == 'team_show' or route == 'my_team') }}
				{% endif %}
			{% endif %}

			{% if is_granted('CATALOG_MANAGE') or is_granted('USER_MANAGE') %}
				{{ nav.group('Administracija') }}
				{% if is_granted('CATALOG_MANAGE') %}
					{{ nav.link(path('admin_job_index'), 'list-checks', 'Katalog poslova', route starts with 'admin_job') }}
					{{ nav.link(path('admin_package_index'), 'package', 'Paketi usluga', route starts with 'admin_package') }}
					{{ nav.link(path('admin_generation'), 'refresh-cw', 'Generisanje zadataka', route starts with 'admin_generation') }}
					{{ nav.link(path('admin_non_working_index'), 'calendar-x', 'Neradni dani', route starts with 'admin_non_working') }}
					{{ nav.link(path('admin_absence_type_index'), 'palmtree', 'Vrste odsustva', route starts with 'admin_absence') }}
					{{ nav.link(path('admin_document_category_index'), 'folder', 'Kategorije dokumenata', route starts with 'admin_document') }}
					{{ nav.link(path('admin_finance'), 'trending-up', 'Finansije', route starts with 'admin_finance') }}
				{% endif %}
				{% if is_granted('USER_MANAGE') %}
					{{ nav.link(path('admin_user_index'), 'contact', 'Korisnici', route starts with 'admin_user') }}
					{{ nav.link(path('admin_position_index'), 'award', 'Pozicije', route starts with 'admin_position') }}
				{% endif %}
			{% endif %}

			{{ nav.group('Pomoć') }}
			{{ nav.link(path('help_index'), 'book-open', 'Uputstvo', route starts with 'help_') }}
		</nav>

		<div class="kt-sidebar-user dropup">
			<button type="button" class="kt-user-toggle" data-bs-toggle="dropdown" aria-expanded="false">
				{{ ui.avatar(app.user, 32) }}
				<span class="kt-user-who"><strong>{{ app.user.fullName }}</strong><span>{{ app.user.highestRole.label }}</span></span>
				{{ ux_icon('lucide:chevron-up', {class: 'kt-icon kt-user-chevron'}) }}
			</button>
			<div class="dropdown-menu">
				<a href="{{ path('app_profile') }}" class="dropdown-item">{{ ux_icon('lucide:circle-user', {class: 'kt-icon'}) }}Moj profil</a>
				<div class="dropdown-divider"></div>
				<a href="{{ path('app_logout') }}" class="dropdown-item">{{ ux_icon('lucide:log-out', {class: 'kt-icon'}) }}Odjava</a>
			</div>
		</div>
	</aside>
	<div class="kt-sidebar-backdrop" data-kt-sidebar-close></div>

	<div class="kt-main">
		<header class="kt-topbar">
			<button type="button" class="kt-icon-btn d-none d-sm-inline-flex d-lg-none" data-kt-sidebar-open aria-label="Otvori meni">{{ ux_icon('lucide:menu', {class: 'kt-icon'}) }}</button>
			<button type="button" class="kt-icon-btn kt-back d-sm-none" data-kt-back aria-label="Nazad">{{ ux_icon('lucide:chevron-left', {class: 'kt-icon'}) }}</button>
			<div class="kt-mobile-title d-sm-none">{{ block('page_title')|striptags|trim }}</div>

			<nav class="kt-breadcrumb" aria-label="Putanja">
				<a href="{{ path('app_dashboard') }}" class="breadcrumb-item" aria-label="Početna">{{ ux_icon('lucide:house', {class: 'kt-icon'}) }}</a>
				{% block breadcrumbs %}
					<span class="breadcrumb-item active">{{ block('page_title') }}</span>
				{% endblock %}
			</nav>

			<div class="kt-topbar-actions">
				<button type="button" class="kt-icon-btn d-sm-none" data-kt-search-open aria-label="Pretraga">{{ ux_icon('lucide:search', {class: 'kt-icon'}) }}</button>
				<div class="dropdown">
					<button type="button" class="kt-icon-btn kt-theme-toggle" data-bs-toggle="dropdown" aria-label="Tema" title="Tema">
						<span data-theme-icon="light">{{ ux_icon('lucide:sun', {class: 'kt-icon'}) }}</span>
						<span data-theme-icon="dark">{{ ux_icon('lucide:moon', {class: 'kt-icon'}) }}</span>
						<span data-theme-icon="system">{{ ux_icon('lucide:monitor', {class: 'kt-icon'}) }}</span>
					</button>
					<div class="dropdown-menu dropdown-menu-end">
						<a href="#" class="dropdown-item" data-theme-choice="light">{{ ux_icon('lucide:sun', {class: 'kt-icon'}) }}Svetla</a>
						<a href="#" class="dropdown-item" data-theme-choice="dark">{{ ux_icon('lucide:moon', {class: 'kt-icon'}) }}Tamna</a>
						<a href="#" class="dropdown-item" data-theme-choice="system">{{ ux_icon('lucide:monitor', {class: 'kt-icon'}) }}Kao sistem</a>
					</div>
				</div>

				<div class="dropdown" id="notification-bell" data-url="{{ path('ajax_notifications') }}" data-read-all-url="{{ path('ajax_notifications_read_all') }}">
					<button type="button" class="kt-icon-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Notifikacije" aria-label="Notifikacije">
						{% set unread = unread_notification_count() %}
						{{ ux_icon('lucide:bell', {class: 'kt-icon'}) }}
						<span class="kt-bell-dot notification-count {{ unread > 0 ? '' : 'd-none' }}">{{ unread }}</span>
					</button>
					<div class="dropdown-menu dropdown-menu-end kt-notification-menu p-0" id="notification-menu">
						{{ include('notification/_menu.html.twig', {items: latest_notifications(), count: unread}) }}
					</div>
				</div>

				<div class="dropdown">
					<button type="button" class="kt-avatar-btn" data-bs-toggle="dropdown" aria-label="Korisnik">{{ ui.avatar(app.user, 32) }}</button>
					<div class="dropdown-menu dropdown-menu-end">
						<a href="{{ path('app_profile') }}" class="dropdown-item">{{ ux_icon('lucide:circle-user', {class: 'kt-icon'}) }}Moj profil</a>
						<div class="dropdown-divider"></div>
						<a href="{{ path('app_logout') }}" class="dropdown-item">{{ ux_icon('lucide:log-out', {class: 'kt-icon'}) }}Odjava</a>
					</div>
				</div>
			</div>
		</header>

		<div class="kt-page-header">
			<h1 class="kt-page-title">{% block page_title %}{% endblock %}</h1>
			{% set page_actions %}{% block page_actions %}{% endblock %}{% endset %}
			{% if page_actions|trim is not empty %}
				<div class="kt-page-actions">{{ page_actions }}</div>
			{% endif %}
		</div>

		<main class="kt-content">
			{# flash poruke posle akcije: toast gore desno (assets/js/confirm.js); bez JS-a ostaju kao alert #}
			{% set flash_list = [] %}
			{% for type, messages in app.flashes %}
				{% for message in messages %}{% set flash_list = flash_list|merge([[type == 'error' ? 'danger' : type, message]]) %}{% endfor %}
			{% endfor %}
			{% if flash_list is not empty %}
				<script type="application/json" data-kt-flashes>{{ flash_list|json_encode|raw }}</script>
				<noscript>
					{% for f in flash_list %}<div class="alert alert-{{ f[0] }} kt-alert" role="alert"><div>{{ f[1] }}</div></div>{% endfor %}
				</noscript>
			{% endif %}

			{% block content %}{% endblock %}
		</main>
	</div>

	{{ include('components/_mobile_nav.html.twig') }}

</div>
</body>
</html>
