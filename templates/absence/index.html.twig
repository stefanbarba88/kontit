{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Odsustva{% endblock %}
{% block page_title %}Odsustva{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Odsustva</span>{% endblock %}

{% macro action_form(absence, action, label, btn, icon) %}
    <form method="post" action="{{ path('absence_action', {id: absence.id, action: action}) }}" class="d-inline"
          {% if action == 'approve' %}{{ confirm_attrs('Odobriti odsustvo?', absence.user.fullName ~ ': ' ~ absence.summary, 'info', 'Da, odobri') }}
          {% elseif action == 'reject' %}{{ confirm_attrs('Odbiti odsustvo?', absence.user.fullName ~ ': ' ~ absence.summary, 'warning', 'Da, odbij') }}
          {% else %}{{ confirm_attrs('Otkazati odsustvo?', 'Backup više neće preuzimati klijente za ovaj period.', 'danger', 'Da, otkaži') }}{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token('absence_' ~ absence.id) }}">
        <button class="btn btn-sm {{ btn }}">{{ ux_icon('lucide:' ~ icon, {class: 'kt-icon me-1'}) }}{{ label }}</button>
    </form>
{% endmacro %}

{% block content %}
    <div class="d-flex align-items-center mb-3">
        <div class="btn-group">
            <a href="{{ path('absence_index') }}" class="btn btn-light {{ current ? 'active' : '' }}">Aktuelna</a>
            <a href="{{ path('absence_index', {history: 1}) }}" class="btn btn-light {{ not current ? 'active' : '' }}">Istorija</a>
        </div>
        <a href="{{ path('absence_new') }}" class="btn btn-primary ms-auto">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Novo odsustvo</a>
    </div>

    {% if pendingAbsences %}
        <div class="card border-warning">
            <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:calendar-check', {class: 'kt-icon me-2'}) }}Čeka tvoje odobrenje <span class="badge bg-warning rounded-pill ms-1">{{ pendingAbsences|length }}</span></h5></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                        {% for a in pendingAbsences %}
                            <tr>
                                <td>{{ ui.user_chip(a.user, 32) }}</td>
                                <td>{{ a.startDate|date('d.m.Y.') }} – {{ a.endDate|date('d.m.Y.') }}<div class="kt-text-sm text-muted">{{ a.reason.label }}{% if a.note %} · {{ a.note }}{% endif %}</div></td>
                                <td class="text-end">
                                    {% if is_granted('ABSENCE_DECIDE', a) %}
                                        {{ _self.action_form(a, 'approve', 'Odobri', 'btn-success', 'check') }}
                                        {{ _self.action_form(a, 'reject', 'Odbij', 'btn-outline-danger', 'x') }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Radnik</th><th>Period</th><th>Razlog</th><th>Status</th><th>Upisao</th><th></th></tr></thead>
                <tbody>
                    {% for a in pagination %}
                        <tr>
                            <td>{{ ui.user_chip(a.user, 32) }}</td>
                            <td>{{ a.startDate|date('d.m.Y.') }} – {{ a.endDate|date('d.m.Y.') }}</td>
                            <td>{{ a.reason.label }}{% if a.note %}<div class="kt-text-sm text-muted">{{ a.note }}</div>{% endif %}</td>
                            <td>
                                <span class="badge kt-badge-{{ a.status.color }}">{{ a.status.label }}</span>
                                {% if a.decidedBy %}<div class="kt-text-xs text-muted">{{ a.decidedBy.fullName }}</div>{% endif %}
                            </td>
                            <td class="kt-text-sm text-muted">{{ a.createdBy.fullName }}</td>
                            <td class="text-end">
                                {% if is_granted('ABSENCE_DECIDE', a) %}
                                    {{ _self.action_form(a, 'approve', 'Odobri', 'btn-success', 'check') }}
                                    {{ _self.action_form(a, 'reject', 'Odbij', 'btn-outline-danger', 'x') }}
                                {% endif %}
                                {% if is_granted('ABSENCE_CANCEL', a) %}
                                    {{ _self.action_form(a, 'cancel', 'Otkaži', 'btn-light', 'ban') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">{{ ui.empty_state(current ? 'Nema aktuelnih odsustava.' : 'Nema odsustava.', 'plane') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
