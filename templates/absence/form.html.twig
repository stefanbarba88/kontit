{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{# Novi zahtev i izmena odsustva (absence je postavljen samo pri izmeni) #}
{% set editing = absence is defined and absence %}
{% set heading = editing ? 'Izmena odsustva' : 'Zahtev za odsustvo' %}

{% block title %}{{ heading }}{% endblock %}
{% block page_title %}{{ heading }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('absence_index') }}" class="breadcrumb-item">Odsustva</a>
    <span class="breadcrumb-item active">{{ editing ? 'Izmena' : 'Novi zahtev' }}</span>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {'data-kt-absence-form': '', 'data-preview-url': path('ajax_absence_preview'), 'data-me': me.id, 'data-absence-id': editing ? absence.id : ''}}) }}
    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    {{ form_errors(form) }}
                    {% if editing %}
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            {{ ui.user_chip(absence.user, 32) }}
                            <span class="badge kt-badge-{{ absence.status.color }} ms-auto">{{ absence.status.label }}</span>
                        </div>
                        {% if absence.editedBy %}<p class="kt-text-sm text-muted">Poslednja izmena: {{ absence.editedBy.fullName }}, {{ absence.editedAt|date('d.m.Y. H:i') }}</p>{% endif %}
                    {% endif %}
                    {% if form.user is defined %}{{ form_row(form.user) }}{% endif %}
                    {{ form_row(form.type) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.startDate) }}</div>
                        <div class="col-md-6">{{ form_row(form.endDate) }}</div>
                    </div>
                    <div data-kt-absence-half-row>{{ form_row(form.halfDay) }}</div>
                    {{ form_row(form.note) }}
                    <div class="kt-text-sm text-muted" data-kt-absence-document hidden>{{ ux_icon('lucide:file-text', {class: 'kt-icon me-1'}) }}Ova vrsta traži dokument (npr. doznaku). Možeš da ga dodaš i kasnije, u roku od 3 dana, u Dokumentima na profilu.</div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:calendar-days', {class: 'kt-icon me-2'}) }}Pregled zahteva</h5></div>
                <div class="card-body border-top">
                    <div class="kt-absence-info" data-kt-absence-info>
                        <p class="text-muted mb-0">Izaberi vrstu i period.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="kt-form-actions">
        {% if editing %}
            <button type="submit" class="btn btn-primary" data-kt-absence-submit
                    {{ confirm_attrs('Sačuvati izmenu odsustva?', absence.user.fullName ~ ': ' ~ absence.summary ~ '. Izmena se beleži u istoriju' ~ (absence.user != me ? ', a radnik dobija obaveštenje.' : '.'), 'warning', 'Da, sačuvaj') }}>Sačuvaj izmenu{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
        {% else %}
            <button class="btn btn-primary" data-kt-absence-submit>{{ canChooseUser ? 'Sačuvaj' : 'Pošalji zahtev' }}{{ ux_icon('lucide:send', {class: 'kt-icon ms-2'}) }}</button>
        {% endif %}
        <a href="{{ path('absence_index') }}" class="btn btn-outline-secondary">Odustani</a>
    </div>
    {{ form_end(form) }}
{% endblock %}
