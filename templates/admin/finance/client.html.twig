{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Analitika — {{ client.name }}{% endblock %}
{% block page_title %}Analitika: {{ client.name }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('client_show', {id: client.id}) }}" class="breadcrumb-item">{{ client.name }}</a>
    <span class="breadcrumb-item active">Analitika</span>
{% endblock %}

{% block content %}
    <div class="row mb-3">
        <div class="col-md-3 mb-3">{{ ui.stat_card('circle-dollar-sign', a.mrr|number_format(0, ',', '.') ~ ' RSD', 'Mesečni prihod (MRR)', 'success') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('receipt', a.oneTime|number_format(0, ',', '.') ~ ' RSD', 'Jednokratno ove godine', 'info') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('clock', a.hours|number_format(1, ',') ~ ' h', 'Procenjeno sati mesečno', 'primary') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('gauge', a.rate is null ? '—' : a.rate|number_format(0, ',', '.') ~ ' RSD', 'Efektivna cena sata', a.underpriced ? 'danger' : 'success', a.underpriced ? 'ispod praga od ' ~ a.minRate|number_format(0, ',', '.') ~ ' RSD' : null) }}</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-3 mb-3">{{ ui.stat_card('list-checks', a.tasksPerMonth|number_format(1, ',') , 'Zadataka mesečno (3 meseca)', 'primary') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('circle-check', a.onTimePercent is null ? '—' : a.onTimePercent ~ '%', 'Završeno na vreme', 'success') }}</div>
        <div class="col-md-3 mb-3">{{ ui.stat_card('hourglass', a.waiting, 'Čeka klijenta (trenutno)', a.waiting ? 'warning' : 'secondary') }}</div>
    </div>

    <div class="card">
        <div class="card-header"><h6 class="mb-0">Paketi i istorija cena</h6></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Od</th><th>Paket</th><th>Stara</th><th>Nova</th><th>Promenio</th></tr></thead>
                <tbody>
                    {% for log in a.priceLog %}
                        <tr>
                            <td>{{ log.effectiveFrom|date('d.m.Y.') }}</td>
                            <td>{{ log.clientPackage.package.name }}</td>
                            <td>{{ log.oldPrice is not null ? log.oldPrice|number_format(2, ',', '.') : '—' }}</td>
                            <td>{{ log.newPrice|number_format(2, ',', '.') }}</td>
                            <td>{{ log.changedBy ? log.changedBy.fullName : '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">{{ ui.empty_state('Nema istorije cena.', 'history') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
