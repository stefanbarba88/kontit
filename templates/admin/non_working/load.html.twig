{% extends 'base.html.twig' %}

{% block title %}Praznici Srbije {{ year }}{% endblock %}
{% block page_title %}Praznici Srbije za {{ year }}.{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('admin_non_working_index', {year: year}) }}" class="breadcrumb-item">Neradni dani</a>
    <span class="breadcrumb-item active">Učitavanje praznika</span>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_non_working_load', {year: year - 1}) }}" class="btn btn-light me-2">{{ year - 1 }}.</a>
    <a href="{{ path('admin_non_working_load', {year: year + 1}) }}" class="btn btn-light">{{ year + 1 }}.</a>
{% endblock %}

{% block content %}
    <div class="card">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('non_working_load') }}">
            <input type="hidden" name="year" value="{{ year }}">
            <div class="card-body border-bottom kt-text-sm text-muted">
                Pregledaj predlog pre čuvanja. Uskrs se računa po pravoslavnom (julijanskom) kalendaru. Praznik koji padne u nedelju predlaže slobodan prvi naredni radni dan; to štikliraj samo ako se slažeš.
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th style="width: 1%;"></th><th>Datum</th><th>Naziv</th><th>Vrsta</th></tr></thead>
                    <tbody>
                        {% for item in proposal %}
                            <tr class="{{ item.exists ? 'text-muted' }}">
                                <td>
                                    {% if item.exists %}
                                        <span title="Već postoji" data-bs-toggle="tooltip">{{ ux_icon('lucide:check', {class: 'kt-icon text-success'}) }}</span>
                                    {% else %}
                                        <input class="form-check-input" type="checkbox" name="pick[]" value="{{ loop.index0 }}" id="pick-{{ loop.index0 }}" {{ item.sundayShift ? '' : 'checked' }}>
                                    {% endif %}
                                </td>
                                <td class="text-nowrap"><label for="pick-{{ loop.index0 }}">{{ item.from|date('d.m.') }}{% if item.to != item.from %} – {{ item.to|date('d.m.') }}{% endif %}</label> <span class="text-muted kt-text-xs">{{ ['', 'pon', 'uto', 'sre', 'čet', 'pet', 'sub', 'ned'][item.from|date('N')] }}</span></td>
                                <td>{{ item.name }}{% if item.exists %} <span class="kt-text-xs">(već postoji)</span>{% endif %}</td>
                                <td><span class="kt-badge kt-badge-{{ item.sundayShift ? 'warning' : item.type.color }}">{{ item.sundayShift ? 'Predlog zbog nedelje' : item.type.label }}</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top kt-form-actions">
                <a href="{{ path('admin_non_working_index', {year: year}) }}" class="btn btn-light">Odustani</a>
                <button class="btn btn-primary">Sačuvaj izabrane</button>
            </div>
        </form>
    </div>
{% endblock %}
