{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Paketi usluga{% endblock %}
{% block page_title %}Paketi usluga{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Paketi usluga</span>{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_job_index') }}" class="btn btn-light me-2">{{ ux_icon('lucide:list-checks', {class: 'kt-icon me-2'}) }}Katalog poslova</a>
    <a href="{{ path('admin_package_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Novi paket</a>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Paket</th><th>Poslovi</th>{% if is_granted('PRICE_VIEW') %}<th class="text-end">Predložena cena</th>{% endif %}<th>Klijenata</th><th>Status</th><th style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for package in packages %}
                        <tr>
                            <td>{{ package.name }}{% if package.description %}<div class="text-muted kt-text-sm">{{ package.description|slice(0, 80) }}</div>{% endif %}</td>
                            <td>{% for job in package.jobTemplates %}<span class="kt-cat-badge me-1 mb-1" style="--kt-cat: {{ job.category.color }};">{{ job.name }}</span>{% endfor %}</td>
                            {% if is_granted('PRICE_VIEW') %}<td class="text-end text-nowrap">{{ package.price is not null ? package.price|number_format(2, ',', '.') ~ ' RSD' : '—' }}</td>{% endif %}
                            <td>{{ clientCounts[package.id] }}</td>
                            <td>{{ ui.status_badge(package.active) }}</td>
                            <td><a href="{{ path('admin_package_edit', {id: package.id}) }}" class="btn kt-btn-icon btn-sm" title="Izmeni">{{ ux_icon('lucide:pencil', {class: 'kt-icon'}) }}</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">{{ ui.empty_state('Još nema paketa.', 'package') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
