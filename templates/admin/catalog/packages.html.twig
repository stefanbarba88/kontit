{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Paketi usluga{% endblock %}
{% block page_title %}Paketi usluga{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Paketi usluga</span>{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_job_index') }}" class="btn btn-light me-2"><i class="ph-list-checks me-2"></i>Katalog poslova</a>
    <a href="{{ path('admin_package_new') }}" class="btn btn-primary"><i class="ph-plus me-2"></i>Novi paket</a>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Paket</th><th>Poslovi</th><th>Klijenata</th><th>Status</th><th style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for package in packages %}
                        <tr>
                            <td>{{ package.name }}{% if package.description %}<div class="text-muted fs-sm">{{ package.description|slice(0, 80) }}</div>{% endif %}</td>
                            <td>{% for job in package.jobTemplates %}<span class="badge bg-light text-body border me-1">{{ job.name }}</span>{% endfor %}</td>
                            <td>{{ clientCounts[package.id] }}</td>
                            <td>{{ ui.status_badge(package.active) }}</td>
                            <td><a href="{{ path('admin_package_edit', {id: package.id}) }}" class="btn btn-light btn-icon btn-sm rounded-pill border-transparent" title="Izmeni"><i class="ph-pencil"></i></a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">{{ ui.empty_state('Još nema paketa.', 'ph-package') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
