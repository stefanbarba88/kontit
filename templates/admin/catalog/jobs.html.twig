{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Katalog poslova{% endblock %}
{% block page_title %}Katalog poslova{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Katalog poslova</span>{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_package_index') }}" class="btn btn-light me-2">{{ ux_icon('lucide:package', {class: 'kt-icon me-2'}) }}Paketi</a>
    <a href="{{ path('admin_job_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Novi posao</a>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Posao</th><th>Kategorija</th><th>Ponavljanje</th><th>Rok</th><th>Trajanje</th><th>Jedinica cene</th><th>Status</th><th style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for job in jobs %}
                        <tr>
                            <td>{{ job.name }}{% if job.checklistItems|length %}<div class="text-muted kt-text-sm">{{ job.checklistItems|length }} stavki checkliste</div>{% endif %}</td>
                            <td><span class="badge bg-light text-body border">{{ job.category.label }}</span></td>
                            <td>{{ job.recurrence.label }}</td>
                            <td>{{ job.dueDay ?? '—' }}{% if job.dueMonth %}.{{ job.dueMonth }}.{% endif %}</td>
                            <td>{{ job.estimatedMinutes }} min</td>
                            <td>{{ job.priceUnit.label }}</td>
                            <td>{{ ui.status_badge(job.active) }}</td>
                            <td><a href="{{ path('admin_job_edit', {id: job.id}) }}" class="btn kt-kt-btn-icon btn-sm" title="Izmeni">{{ ux_icon('lucide:pencil', {class: 'kt-icon'}) }}</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8">{{ ui.empty_state('Katalog je prazan.', 'list-checks') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
