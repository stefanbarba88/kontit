{% extends 'base.html.twig' %}
{% import 'components/schedule_form.html.twig' as sf %}
{% import 'components/checklist_editor.html.twig' as ce %}

{% set is_new = job.id is null %}

{% block title %}{{ is_new ? 'Novi posao' : 'Izmena posla' }}{% endblock %}
{% block page_title %}{{ is_new ? 'Novi posao' : 'Izmena: ' ~ job.name }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('admin_job_index') }}" class="breadcrumb-item">Katalog poslova</a>
    <span class="breadcrumb-item active">{{ is_new ? 'Novi' : 'Izmena' }}</span>
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Podaci o poslu</h5></div>
                <div class="card-body border-top">
                    <div class="row">
                        <div class="col-md-7">{{ form_row(form.name) }}</div>
                        <div class="col-md-5">{{ form_row(form.category) }}</div>
                    </div>
                    {{ form_row(form.description) }}
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:calendar-clock', {class: 'kt-icon me-2'}) }}Raspored izvršavanja</h5></div>
                <div class="card-body border-top">{{ sf.fields(form.schedule) }}</div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:list-checks', {class: 'kt-icon me-2'}) }}Checklista</h5></div>
                <div class="card-body border-top">{{ ce.editor(form.checklistItems) }}</div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Zadatak i cena</h5></div>
                <div class="card-body border-top">
                    {{ form_row(form.defaultPriority) }}
                    {{ form_row(form.completionMode) }}
                    {{ form_row(form.requiresApproval) }}
                    {{ form_row(form.approvers) }}
                    {{ form_row(form.estimatedMinutes) }}
                    {{ form_row(form.priceUnit) }}
                    {{ form_row(form.defaultPrice) }}
                    {{ form_row(form.active) }}
                </div>
            </div>
        </div>
    </div>
    <div class="kt-form-actions">
        <a href="{{ path('admin_job_index') }}" class="btn btn-light me-2">Otkaži</a>
        <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
    </div>
    {{ form_end(form) }}
{% endblock %}
