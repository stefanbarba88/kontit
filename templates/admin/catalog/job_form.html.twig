{% extends 'base.html.twig' %}

{% set is_new = job.id is null %}

{% block title %}{{ is_new ? 'Novi posao' : 'Izmena posla' }}{% endblock %}
{% block page_title %}{{ is_new ? 'Novi posao' : 'Izmena: ' ~ job.name }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('admin_job_index') }}" class="breadcrumb-item">Katalog poslova</a>
    <span class="breadcrumb-item active">{{ is_new ? 'Novi' : 'Izmena' }}</span>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Podaci o poslu</h5></div>
                <div class="card-body border-top">
                    {{ form_start(form) }}
                        {{ form_row(form.name) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.category) }}</div>
                            <div class="col-md-6">{{ form_row(form.recurrence) }}</div>
                        </div>
                        {{ form_row(form.description) }}
                        <div class="row">
                            <div class="col-md-4">{{ form_row(form.dueDay) }}</div>
                            <div class="col-md-4">{{ form_row(form.dueMonth) }}</div>
                            <div class="col-md-4">{{ form_row(form.generateDaysBefore) }}</div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">{{ form_row(form.defaultPriority) }}</div>
                            <div class="col-md-4">{{ form_row(form.completionMode) }}</div>
                            <div class="col-md-4">{{ form_row(form.estimatedMinutes) }}</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.priceUnit) }}</div>
                        </div>
                        {{ form_row(form.checklist) }}
                        {{ form_row(form.active) }}
                        <div class="text-end">
                            <a href="{{ path('admin_job_index') }}" class="btn btn-light me-2">Otkaži</a>
                            <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
