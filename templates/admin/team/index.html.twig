{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Timovi{% endblock %}
{% block page_title %}Timovi{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Timovi</span>{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_team_new') }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Novi tim</a>
{% endblock %}

{% block content %}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Tim</th><th>Šef</th><th>Članova</th><th class="text-center" style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for team in pagination %}
                        <tr>
                            <td>
                                <a href="{{ path('team_show', {id: team.id}) }}" class="text-body">{{ ui.team_badge(team) }}</a>
                                {% if team.description %}<div class="text-muted kt-text-sm mt-1">{{ team.description|slice(0, 80) }}</div>{% endif %}
                            </td>
                            <td>{{ ui.user_chip(team.leader) }}</td>
                            <td>{{ team.activeMembers|length }}</td>
                            <td class="text-center">
                                <a href="{{ path('admin_team_edit', {id: team.id}) }}" class="btn btn-ghost kt-btn-icon btn-sm" title="Izmeni">{{ ux_icon('lucide:pencil', {class: 'kt-icon'}) }}</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">{{ ui.empty_state('Još nema timova.', 'users') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
