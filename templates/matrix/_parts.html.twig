{#
    Delovi matrice "Pregled poslova po klijentima" (SPEC 8r), zajednički za početnu, stranicu i AJAX osvežavanje.
    Ćelija je samo status (ikonica u boji), bez brojača; dugme otvara SweetAlert prozor sa zadacima (assets/js/matrix.js); hover ima samo običan title.
    Boja nije jedini nosilac značenja: uz nju idu ikonica i tekst u title / aria-label.
#}
{% macro cell(cell, client, job, label) %}
    {% if cell.state.value == 'none' %}
        <span class="kt-mx-none" title="Klijent nema ovaj posao ili zadatak još nije generisan za izabrani mesec" aria-label="{{ label }}: klijent nema ovaj posao ili zadatak još nije generisan za izabrani mesec">—</span>
    {% else %}
        <button type="button" class="kt-mx-cell kt-mx-{{ cell.state.value }}" data-kt-mx-cell data-client="{{ client.id }}" data-job="{{ job }}" title="{{ cell.state.label }}: {{ cell.summary }}" aria-label="{{ label }}: {{ cell.state.label }}, {{ cell.summary }}">
            {{ ux_icon('lucide:' ~ cell.state.icon, {class: 'kt-icon'}) }}
        </button>
    {% endif %}
{% endmacro %}

{% macro people(row) %}
    {% import 'components/ui.html.twig' as ui %}
    <div class="kt-mx-people">
        {% if row.primary %}<div class="kt-mx-primary">{{ ui.avatar(row.primary, 24) }}<span>{{ row.primary.fullName }}</span></div>{% endif %}
        {% if row.backup %}<div class="kt-mx-backup" title="Backup">{{ ui.avatar(row.backup, 18) }}<span>{{ row.backup.fullName }}</span></div>{% endif %}
    </div>
{% endmacro %}

{% macro rows(mx) %}
    {% import _self as p %}
    {% for row in mx.rows %}
        <tr>
            <th scope="row" class="kt-mx-col-client"><a href="{{ path('client_show', {id: row.client.id}) }}" class="kt-mx-client">{{ row.client.shortName }}</a></th>
            <td class="kt-mx-col-people">{{ p.people(row) }}</td>
            {% for job in mx.columns %}
                <td class="text-center">{{ p.cell(row.cells[job.id], row.client, job.id, job.name ~ ' · ' ~ row.client.shortName) }}</td>
            {% endfor %}
        </tr>
    {% endfor %}
{% endmacro %}

{% macro cards(mx) %}
    {% import _self as p %}
    {% for row in mx.rows %}
        <div class="kt-mx-card">
            <div class="kt-mx-card-head"><a href="{{ path('client_show', {id: row.client.id}) }}" class="kt-mx-client">{{ row.client.shortName }}</a>{{ p.people(row) }}</div>
            <div class="kt-mx-chips">
                {% set shown = 0 %}
                {% for job in mx.columns %}
                    {% if row.cells[job.id].state.value != 'none' %}
                        {% set shown = shown + 1 %}
                        <div class="kt-mx-chip"><span class="kt-mx-chip-name" title="{{ job.name }}">{{ job.name }}</span>{{ p.cell(row.cells[job.id], row.client, job.id, job.name ~ ' · ' ~ row.client.shortName) }}</div>
                    {% endif %}
                {% endfor %}
                {% if shown == 0 %}<span class="kt-text-sm text-muted">Nema zadataka iz ove kategorije u izabranom mesecu.</span>{% endif %}
            </div>
        </div>
    {% endfor %}
{% endmacro %}

{% macro foot(mx, full) %}
    {% set shown = min(mx.page * mx.perPage, mx.total) %}
    <span class="text-muted kt-text-sm">Prikazano {{ shown }} od {{ mx.total }} klijenata</span>
    {% if mx.hasMore %}
        {% if full %}<button type="button" class="btn btn-outline-secondary btn-sm" data-kt-mx-more>Učitaj još</button>
        {% else %}<a href="{{ path('matrix_index', mx.filters.toQuery) }}" class="btn btn-outline-secondary btn-sm">Prikaži sve klijente{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a>{% endif %}
    {% endif %}
{% endmacro %}
