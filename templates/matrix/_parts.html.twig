{#
    Delovi matrice "Pregled poslova po klijentima" (SPEC 8r), zajednički za početnu, stranicu i AJAX osvežavanje.
    Ćelija je dugme koje otvara SweetAlert prozor sa zadacima (assets/js/matrix.js); hover ima samo običan title.
    Boja nije jedini nosilac značenja: uz nju idu ikonica i tekst u title / aria-label.
#}
{% macro cell(cell, client, package, label) %}
    {% if cell.state.value == 'none' %}
        <span class="kt-mx-none" title="{{ cell.summary }}" aria-label="{{ label }}: nema zadataka u periodu">—</span>
    {% else %}
        <button type="button" class="kt-mx-cell kt-mx-{{ cell.state.value }}" data-kt-mx-cell data-client="{{ client.id }}" data-package="{{ package }}" title="{{ cell.summary }}" aria-label="{{ label }}: {{ cell.summary }}">
            <span class="kt-mx-top">
                {% if cell.state.value == 'danger' %}{{ ux_icon('lucide:triangle-alert', {class: 'kt-icon'}) }}
                {% elseif cell.state.value == 'success' %}{{ ux_icon('lucide:circle-check-big', {class: 'kt-icon'}) }}
                {% elseif cell.state.value == 'warning' %}{{ ux_icon('lucide:clock-alert', {class: 'kt-icon'}) }}{% endif %}
                <span class="kt-mx-num">{{ cell.done }}/{{ cell.total }}</span>
            </span>
            <span class="kt-mx-bar"><span style="width: {{ cell.percent }}%"></span></span>
        </button>
    {% endif %}
{% endmacro %}

{% macro people(row) %}
    {% import 'components/ui.html.twig' as ui %}
    <div class="kt-mx-people">
        {% if row.primary %}<div class="kt-mx-primary">{{ ui.avatar(row.primary, 24) }}<span>{{ row.primary.fullName }}</span></div>{% endif %}
        {% if row.backup %}<div class="kt-mx-backup" title="Backup">{{ ui.avatar(row.backup, 18) }}<span>{{ row.backup.fullName }}</span></div>{% endif %}
    </div>
{% endmacro %}

{% macro rows(mx) %}
    {% import _self as p %}
    {% for row in mx.rows %}
        <tr>
            <th scope="row" class="kt-mx-col-client"><a href="{{ path('client_show', {id: row.client.id}) }}" class="kt-mx-client">{{ row.client.shortName }}</a></th>
            <td class="kt-mx-col-people">{{ p.people(row) }}</td>
            {% for pkg in mx.columns %}
                <td class="text-center">{{ p.cell(row.cells[pkg.id], row.client, pkg.id, pkg.name ~ ' · ' ~ row.client.shortName) }}</td>
            {% endfor %}
            <td class="text-center kt-mx-col-other">{{ p.cell(row.other, row.client, 'none', 'Ostali taskovi · ' ~ row.client.shortName) }}</td>
        </tr>
    {% endfor %}
{% endmacro %}

{% macro cards(mx) %}
    {% import _self as p %}
    {% for row in mx.rows %}
        <div class="kt-mx-card">
            <div class="kt-mx-card-head"><a href="{{ path('client_show', {id: row.client.id}) }}" class="kt-mx-client">{{ row.client.shortName }}</a>{{ p.people(row) }}</div>
            <div class="kt-mx-chips">
                {% for pkg in mx.columns %}
                    {% if row.cells[pkg.id].state.value != 'none' %}
                        <div class="kt-mx-chip"><span class="kt-mx-chip-name">{{ pkg.name }}</span>{{ p.cell(row.cells[pkg.id], row.client, pkg.id, pkg.name ~ ' · ' ~ row.client.shortName) }}</div>
                    {% endif %}
                {% endfor %}
                <div class="kt-mx-chip kt-mx-chip-other"><span class="kt-mx-chip-name">Ostali taskovi</span>{{ p.cell(row.other, row.client, 'none', 'Ostali taskovi · ' ~ row.client.shortName) }}</div>
            </div>
        </div>
    {% endfor %}
{% endmacro %}

{% macro foot(mx, full) %}
    {% set shown = min(mx.page * mx.perPage, mx.total) %}
    <span class="text-muted kt-text-sm">Prikazano {{ shown }} od {{ mx.total }} klijenata</span>
    {% if mx.hasMore %}
        {% if full %}<button type="button" class="btn btn-outline-secondary btn-sm" data-kt-mx-more>Učitaj još</button>
        {% else %}<a href="{{ path('matrix_index', mx.filters.toQuery) }}" class="btn btn-outline-secondary btn-sm">Prikaži sve klijente{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a>{% endif %}
    {% endif %}
{% endmacro %}
