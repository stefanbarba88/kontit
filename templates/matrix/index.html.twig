{% extends 'base.html.twig' %}

{% block title %}Pregled poslova po klijentima{% endblock %}
{% block page_title %}Pregled poslova po klijentima{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Pregled poslova</span>{% endblock %}

{% block page_actions %}
    {% import 'components/export.html.twig' as export %}
    <div data-kt-mx-export>{{ export.menu('pregled', mx.filters.toQuery) }}</div>
{% endblock %}

{% block content %}
