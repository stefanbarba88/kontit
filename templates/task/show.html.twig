{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}
{% import 'components/timeline.html.twig' as tl %}

{% set me_assignee = task.findAssignee(app.user) %}
{% set can_complete = is_granted('TASK_COMPLETE', task) %}

{% block title %}{{ task.title }}{% endblock %}
{% block page_title %}{{ task.title }} {{ ui.task_status(task.status) }}{% if task.takenOverFrom %} <span class="badge kt-badge-info" title="Zadatak je dobila zamena jer je {{ task.takenOverFrom.fullName }} bio na odsustvu" data-bs-toggle="tooltip">PREUZETO</span>{% endif %}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('task_index') }}" class="breadcrumb-item">Zadaci</a>
    <span class="breadcrumb-item active">{{ task.title }}</span>
{% endblock %}

{% block page_actions %}
    {% if is_granted('TASK_EDIT', task) %}
        <a href="{{ path('task_edit', {id: task.id}) }}" class="btn btn-primary">{{ ux_icon('lucide:pencil', {class: 'kt-icon me-2'}) }}Izmeni</a>
    {% endif %}
    {% if can_complete and task.status.value in ['U_RADU', 'NOVO'] %}
        <form method="post" action="{{ path('task_waiting', {id: task.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('task_waiting_' ~ task.id) }}">
            <input type="hidden" name="waiting" value="1">
            <button class="btn btn-outline-warning">{{ ux_icon('lucide:hourglass', {class: 'kt-icon me-2'}) }}Čeka klijenta</button>
        </form>
    {% elseif can_complete and task.status.value == 'CEKA_KLIJENTA' %}
        <form method="post" action="{{ path('task_waiting', {id: task.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('task_waiting_' ~ task.id) }}">
            <input type="hidden" name="waiting" value="0">
            <button class="btn btn-outline-primary">{{ ux_icon('lucide:refresh-cw', {class: 'kt-icon me-2'}) }}Nastavi rad</button>
        </form>
    {% endif %}
    {% if is_granted('TASK_CANCEL', task) %}
        <form method="post" action="{{ path('task_cancel', {id: task.id}) }}" {{ confirm_attrs('Otkazati zadatak?', 'Zadatak će biti otkazan za sve učesnike.', 'danger', 'Da, otkaži', true) }}>
            <input type="hidden" name="_token" value="{{ csrf_token('task_cancel_' ~ task.id) }}">
            <button class="btn btn-outline-danger">Otkaži zadatak</button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    <div id="task-page" data-task-id="{{ task.id }}" data-status="{{ task.status.value }}"
         data-checklist-url="{{ path('ajax_checklist_add', {id: task.id}) }}"
         data-reorder-url="{{ path('ajax_checklist_reorder', {id: task.id}) }}"
         data-comment-url="{{ path('ajax_comment_add', {id: task.id}) }}"
         data-toggle-url="{{ path('ajax_checklist_toggle', {id: 0}) }}"
         data-assign-url="{{ path('ajax_checklist_assign', {id: 0}) }}"
         data-delete-url="{{ path('ajax_checklist_delete', {id: 0}) }}"
         data-comment-edit-url="{{ path('ajax_comment_edit', {id: 0}) }}">

    {% if task.status.value == 'NA_PROVERI' and is_granted('TASK_APPROVE', task) %}
        <div class="card border-info">
            <div class="card-header bg-info bg-opacity-10"><h5 class="mb-0">{{ ux_icon('lucide:circle-check', {class: 'kt-icon me-2'}) }}Čeka tvoju potvrdu</h5></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3 align-items-start">
                    <form method="post" action="{{ path('task_approve', {id: task.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('task_approve_' ~ task.id) }}">
                        <button class="btn btn-success" {{ confirm_attrs('Potvrditi zadatak?', 'Zadatak postaje završen.', 'info', 'Da, potvrdi') }}>{{ ux_icon('lucide:check', {class: 'kt-icon me-2'}) }}Potvrdi</button>
                    </form>
                    <form method="post" action="{{ path('task_return', {id: task.id}) }}" class="flex-fill">
                        <input type="hidden" name="_token" value="{{ csrf_token('task_return_' ~ task.id) }}">
                        <textarea name="reason" class="form-control mb-2" rows="2" placeholder="Razlog vraćanja na doradu (obavezno)" required></textarea>
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" name="email" value="1" id="return-email">
                            <label class="form-check-label" for="return-email">Pošalji i na mail</label>
                        </div>
                        <button class="btn btn-outline-warning" {{ confirm_attrs('Vratiti zadatak na doradu?', 'Učesnici dobijaju razlog i zadatak se vraća u rad.', 'warning', 'Da, vrati') }}>{{ ux_icon('lucide:undo-2', {class: 'kt-icon me-2'}) }}Vrati na doradu</button>
                    </form>
                </div>
            </div>
        </div>
    {% elseif task.status.value == 'NA_PROVERI' %}
        <div class="alert alert-info">{{ ux_icon('lucide:info', {class: 'kt-icon me-2'}) }}Zadatak je poslat na proveru{% if task.submittedAt %} ({{ task.submittedAt|date('d.m.Y. H:i') }}){% endif %}.</div>
    {% elseif task.status.value == 'ZAVRSENO' and task.approvedBy %}
        <div class="alert alert-success">{{ ux_icon('lucide:circle-check', {class: 'kt-icon me-2'}) }}Potvrdio {{ task.approvedBy.fullName }}, {{ task.approvedAt|date('d.m.Y. H:i') }}.</div>
    {% endif %}

    <div class="row">
        <div class="col-lg-8">
            {% if task.description %}
                <div class="card">
                    <div class="card-header"><h5 class="mb-0">Opis</h5></div>
                    <div class="card-body border-top">{{ task.description|nl2br }}</div>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h5 class="mb-0">{{ ux_icon('lucide:list-checks', {class: 'kt-icon me-2'}) }}Checklist</h5>
                    <span class="ms-auto text-muted" id="checklist-progress">{{ task.checklistDone }}/{{ task.checklistTotal }}</span>
                </div>
                <ul class="list-group list-group-flush border-top" id="checklist">
                    {% for item in task.checklistItems %}
                        {{ include('task/_checklist_item.html.twig', {item: item, task: task}) }}
                    {% endfor %}
                </ul>
                <div class="text-muted text-center py-3 {{ task.checklistTotal ? 'd-none' : '' }}" id="checklist-empty">Nema stavki.</div>
                {% if is_granted('TASK_EDIT', task) %}
                    <div class="card-body border-top">
                        <form id="checklist-add" class="row g-2">
                            <div class="col-12 col-md-6"><input type="text" class="form-control" name="text" maxlength="255" placeholder="Nova stavka" required></div>
                            <div class="col-8 col-md-4">
                                <select name="assignedTo" class="form-select">
                                    <option value="">Zajednička</option>
                                    {% for a in task.assignees %}<option value="{{ a.user.id }}">{{ a.user.fullName }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-4 col-md-2"><button class="btn btn-light w-100">{{ ux_icon('lucide:plus', {class: 'kt-icon me-1'}) }}Dodaj</button></div>
                        </form>
                    </div>
                {% endif %}
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:message-square-text', {class: 'kt-icon me-2'}) }}Komentari</h5></div>
                <div class="card-body border-top">
                    <div id="comments">
                        {% for comment in task.comments %}
                            {{ include('task/_comment.html.twig', {comment: comment}) }}
                        {% endfor %}
                    </div>
                    <div class="text-muted text-center py-2 {{ task.comments|length ? 'd-none' : '' }}" id="comments-empty">Još nema komentara.</div>
                    <form id="comment-add">
                        <textarea name="body" class="form-control mb-2" rows="2" placeholder="Napiši komentar" required></textarea>
                        <button class="btn btn-primary">Pošalji{{ ux_icon('lucide:send', {class: 'kt-icon ms-2'}) }}</button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:history', {class: 'kt-icon me-2'}) }}Istorija</h5></div>
                <div class="card-body border-top">{{ tl.feed(path('ajax_task_activity', {id: task.id}), activity) }}</div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Detalji</h5></div>
                <div class="card-body border-top">
                    <dl class="row mb-0">
                        <dt class="col-5">Klijent</dt>
                        <dd class="col-7">{% if task.client %}{% if is_granted('CLIENT_VIEW', task.client) %}<a href="{{ path('client_show', {id: task.client.id}) }}">{{ task.client.shortName }}</a>{% else %}{{ task.client.shortName }}{% endif %}{% else %}<span class="text-muted">Interni</span>{% endif %}</dd>
                        <dt class="col-5">Rok</dt><dd class="col-7">{{ ui.due_date(task) }}</dd>
                        <dt class="col-5">Prioritet</dt><dd class="col-7">{{ ui.priority_badge(task.priority) }}</dd>
                        <dt class="col-5">Završetak</dt><dd class="col-7">{{ task.completionMode.value == 'ALL' ? 'Svi učesnici' : 'Dovoljan jedan' }}</dd>
                        <dt class="col-5">Kreirao</dt><dd class="col-7">{{ task.createdBy.fullName }}<div class="text-muted kt-text-sm">{{ task.createdAt|date('d.m.Y.') }}</div></dd>
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h5 class="mb-0">Učesnici</h5>
                    <span class="ms-auto text-muted kt-text-sm">{{ task.finishedAssigneesCount }}/{{ task.assignees|length }} završilo</span>
                </div>
                <ul class="list-group list-group-flush border-top">
                    {% for a in task.assignees %}
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                {{ ui.user_chip(a.user, 32) }}
                                <span class="ms-auto">{{ ui.assignee_status(a.status) }}</span>
                            </div>
                            {% if a.completedAt %}<div class="kt-text-xs text-muted mt-1">Završio {{ a.completedAt|date('d.m. H:i') }}</div>{% endif %}
                            {% if a.note %}<div class="kt-text-sm mt-1">„{{ a.note }}“</div>{% endif %}
                        </li>
                    {% endfor %}
                </ul>

                {% set replaced = substituting_for(task) %}
                {% if replaced and not me_assignee and can_complete and task.status.workable %}
                    <div class="card-body border-top">
                        <div class="alert alert-info mb-2">
                            <span class="badge bg-info me-1">PREUZETO</span>
                            Zamenjuješ: <strong>{% for u in replaced %}{{ u.fullName }}{% if not loop.last %}, {% endif %}{% endfor %}</strong>.
                        </div>
                        <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'done'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                            <input type="text" name="note" class="form-control mb-2" maxlength="250" placeholder="Napomena (opciono)">
                            <button class="btn btn-success w-100">{{ ux_icon('lucide:check', {class: 'kt-icon me-2'}) }}Završi deo kolege (zamena)</button>
                        </form>
                    </div>
                {% endif %}

                {% if me_assignee and can_complete and task.status.workable %}
                    <div class="card-body border-top">
                        {% if me_assignee.status.value == 'ZAVRSIO' %}
                            <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'undo'}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                                <button class="btn btn-light w-100">Vrati moj deo u rad</button>
                            </form>
                        {% else %}
                            {% if me_assignee.status.value == 'NOVO' %}
                                <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'start'}) }}" class="mb-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                                    <button class="btn btn-outline-primary w-100">{{ ux_icon('lucide:play', {class: 'kt-icon me-2'}) }}Počinjem rad</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'done'}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                                <input type="text" name="note" class="form-control mb-2" maxlength="250" placeholder="Napomena (opciono)">
                                <button class="btn btn-success w-100">{{ ux_icon('lucide:check', {class: 'kt-icon me-2'}) }}Moj deo je gotov</button>
                            </form>
                        {% endif %}
                    </div>
                {% elseif me_assignee and me_assignee.status.value == 'ZAVRSIO' and task.status.value == 'NA_PROVERI' %}
                    <div class="card-body border-top">
                        <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'undo'}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                            <button class="btn btn-light w-100">Vrati moj deo u rad</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    </div>

    {# telefon: "Moj deo je gotov" lepljivo na dnu, iznad donje navigacije (DESIGN.md 16.4) #}
    {% if me_assignee and can_complete and task.status.workable and me_assignee.status.value != 'ZAVRSIO' %}
        <div class="kt-mobile-actionbar">
            <form method="post" action="{{ path('task_my_part', {id: task.id, action: 'done'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('task_my_part_' ~ task.id) }}">
                <button class="btn btn-success">{{ ux_icon('lucide:check', {class: 'kt-icon me-2'}) }}Moj deo je gotov</button>
            </form>
        </div>
    {% endif %}
{% endblock %}
