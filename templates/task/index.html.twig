{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% set tabs = {
    'all': 'Svi',
    'today': 'Danas',
    'week': 'Ova nedelja',
    'overdue': 'Kasne',
    'review': 'Na proveri',
} %}
{% if canSeeAll %}{% set tabs = tabs|merge({'approval': 'Čeka moju potvrdu'}) %}{% endif %}

{% block title %}Zadaci{% endblock %}
{% block page_title %}Zadaci{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Zadaci</span>{% endblock %}

{% block page_actions %}
    <a href="{{ path('task_new') }}" class="btn btn-primary"><i class="ph-plus me-2"></i>Novi zadatak</a>
{% endblock %}

{% block content %}
    <div class="card">
        <ul class="nav nav-tabs nav-tabs-underline px-3 pt-2">
            {% for key, label in tabs %}
                <li class="nav-item">
                    <a href="{{ path('task_index', filters|merge({tab: key, page: null})) }}" class="nav-link {{ filters.tab == key ? 'active' : '' }}">
                        {{ label }}
                        {% if key == 'approval' and approvalCount > 0 %}<span class="badge bg-danger rounded-pill ms-2">{{ approvalCount }}</span>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>

        {% if filters.tab != 'approval' %}
            <div class="card-body border-top">
                <form method="get" class="row g-2">
                    <input type="hidden" name="tab" value="{{ filters.tab }}">
                    <div class="col-12 col-md-4">
                        <select name="client" class="form-select">
                            <option value="">Svi klijenti</option>
                            {% for client in clients %}
                                <option value="{{ client.id }}" {{ filters.client == client.id ? 'selected' : '' }}>{{ client.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select name="priority" class="form-select">
                            <option value="">Svi prioriteti</option>
                            {% for p in enum_cases('App\\Enum\\TaskPriority') %}
                                <option value="{{ p.value }}" {{ filters.priority == p.value ? 'selected' : '' }}>{{ p.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if canSeeAll %}
                        <div class="col-6 col-md-3">
                            <select name="scope" class="form-select">
                                <option value="mine" {{ filters.scope == 'mine' ? 'selected' : '' }}>Moji zadaci</option>
                                <option value="all" {{ filters.scope == 'all' ? 'selected' : '' }}>Svi zadaci u mom opsegu</option>
                            </select>
                        </div>
                    {% endif %}
                    <div class="col-12 col-md-2">
                        <button class="btn btn-light w-100"><i class="ph-funnel me-2"></i>Traži</button>
                    </div>
                </form>
            </div>
        {% endif %}
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Zadatak</th><th>Klijent</th><th>Učesnici</th><th>Rok</th><th>Prioritet</th><th>Napredak</th><th>Status</th></tr>
                </thead>
                <tbody>
                    {% for task in pagination %}
                        <tr>
                            <td>
                                <a href="{{ path('task_show', {id: task.id}) }}" class="fw-semibold">{{ task.title }}</a>
                                {% if substituting_for(task) %}<span class="badge bg-info bg-opacity-20 text-info ms-1" title="Zamenjujete: {% for u in substituting_for(task) %}{{ u.fullName }}{% endfor %}">PREUZETO</span>{% endif %}
                            </td>
                            <td>{% if task.client %}{{ task.client.name }}{% else %}<span class="text-muted">Interni</span>{% endif %}</td>
                            <td>
                                <div class="d-flex">
                                    {% for a in task.assignees %}{{ ui.avatar(a.user, 24, 'me-1') }}{% endfor %}
                                </div>
                            </td>
                            <td>{{ ui.due_date(task) }}</td>
                            <td>{{ ui.priority_badge(task.priority) }}</td>
                            <td class="fs-sm text-muted">
                                {{ task.finishedAssigneesCount }}/{{ task.assignees|length }} učesnika
                                {% if task.checklistTotal > 0 %}<br>checklist {{ task.checklistDone }}/{{ task.checklistTotal }}{% endif %}
                            </td>
                            <td>{{ ui.task_status(task.status) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">{{ ui.empty_state('Nema zadataka za izabrani prikaz.', 'ph-list-checks') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
