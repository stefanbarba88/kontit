{% extends 'base.html.twig' %}

{% set tabs = {
    'all': 'Svi',
    'today': 'Danas',
    'week': 'Ova nedelja',
    'overdue': 'Kasne',
    'review': 'Na proveri',
} %}
{% if list.canSeeAll %}{% set tabs = tabs|merge({'approval': 'Čeka moju potvrdu'}) %}{% endif %}

{% block title %}Zadaci{% endblock %}
{% block page_title %}Zadaci{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Zadaci</span>{% endblock %}

{% block page_actions %}
    {% import 'components/export.html.twig' as export %}
    {{ export.menu('zadaci', list.exportQuery) }}
    <a href="{{ path('task_new', {returnTo: return_to_path()}) }}" class="btn btn-primary">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}Novi zadatak</a>
{% endblock %}

{% block content %}
    {% include 'components/_task_list.html.twig' with {list: list, tabs: tabs} only %}
{% endblock %}
