{#
    "Podseti me" (zadatak ili klijent): naslov unapred popunjen, izbor datuma i vremena. Pravi stavku Moje liste (assets/js/todo.js).
    Jedan modal za celu aplikaciju; dugme ima [data-kt-remind] i data-task-id ili data-client-id i data-title.
#}
{% set remindDefault = todo_chips()[1] %}
<div class="modal fade" id="kt-remind-modal" tabindex="-1" aria-labelledby="kt-remind-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-default-date="{{ remindDefault.date }}" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title" id="kt-remind-title">{{ ux_icon('lucide:bell-plus', {class: 'kt-icon me-2'}) }}Podseti me</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
            </div>
            <div class="modal-body">
                <div class="kt-text-sm text-muted mb-3">{{ ux_icon('lucide:lock', {class: 'kt-icon me-1'}) }}Podsetnik ide u tvoju privatnu listu.</div>
                <div class="mb-3">
                    <label class="form-label" for="kt-remind-name">Naslov</label>
                    <input type="text" class="form-control" id="kt-remind-name" name="title" maxlength="200" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-7"><label class="form-label" for="kt-remind-date">Datum</label><input type="text" class="form-control" id="kt-remind-date" name="date" data-datepicker placeholder="Izaberi datum"></div>
                    <div class="col-5"><label class="form-label" for="kt-remind-time">Vreme</label><input type="time" class="form-control" id="kt-remind-time" name="time" value="09:00"></div>
                </div>
                <div class="form-check"><input class="form-check-input" type="checkbox" name="remindByEmail" id="kt-remind-email"><label class="form-check-label" for="kt-remind-email">Pošalji podsetnik i na mail</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Odustani</button>
                <button type="submit" class="btn btn-primary">Podseti me</button>
            </div>
        </form>
    </div>
</div>
