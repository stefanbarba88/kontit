{#
    Telo Moje liste, isto u bočnom panelu, na /moja-lista i u kartici na početnoj: dugme "+ Dodaj" (SweetAlert prozor) i sekcije.
    Svaki koren [data-kt-todo] osvežava assets/js/todo.js posle svake akcije. Ulaz: sections, found, query, add (prikaži dugme "+ Dodaj").
#}
<div class="kt-todo" data-kt-todo data-url="{{ path('ajax_todo') }}" data-query="{{ query }}">
    {% if add|default(true) %}
        <div class="kt-todo-toolbar">
            <button type="button" class="btn btn-primary kt-todo-new" data-todo-new>{{ ux_icon('lucide:plus', {class: 'kt-icon me-1'}) }}Dodaj</button>
            <span class="kt-text-sm text-muted d-none d-md-inline">ili pritisni <kbd>n</kbd></span>
        </div>
    {% endif %}
    <div class="kt-todo-list" data-kt-todo-list>
        {% include 'todo/_sections.html.twig' with {sections: sections, found: found, query: query} only %}
    </div>
</div>