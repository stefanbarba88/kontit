{#
    Bočni panel "Podsetnik" (offcanvas desno; na telefonu bottom sheet). Sadržaj se učitava AJAX-om pri prvom otvaranju (assets/js/todo.js).
#}
<div class="offcanvas offcanvas-end kt-sheet kt-todo-panel" tabindex="-1" id="kt-todo-panel" aria-labelledby="kt-todo-panel-title" data-kt-todo-panel data-chips="{{ todo_chips()|json_encode }}" data-repeats="{{ todo_repeat_options()|json_encode }}">
    <div class="kt-sheet-handle"></div>
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="kt-todo-panel-title">{{ ux_icon('lucide:notebook-pen', {class: 'kt-icon me-2'}) }}Podsetnik</h5>
        <a href="{{ path('todo_index') }}" class="btn btn-ghost btn-sm ms-auto me-1">Otvori celu stranicu{{ ux_icon('lucide:arrow-right', {class: 'kt-icon ms-1'}) }}</a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Zatvori"></button>
    </div>
    <div class="offcanvas-body">
        {% include 'todo/_body.html.twig' with {sections: null, found: [], query: ''} only %}
    </div>
</div>
