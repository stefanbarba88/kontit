{#
    Sadržaj liste Podsetnika (panel i /podsetnik). Iscrtava se i iz AJAX odgovora (Ajax\TodoController::state).
    sections: overdue, today, upcoming, nodue, done (ili null kad se traži), found: rezultati pretrage, query: upit.
#}
{% set titles = {overdue: 'Zakasnelo', today: 'Danas', upcoming: 'Predstojeće', nodue: 'Bez roka'} %}
{% if sections is null and query == '' %}
    <div class="kt-todo-empty">Učitavam…</div>
{% elseif sections is null %}
    <div class="kt-todo-section">
        <div class="kt-todo-head">Rezultati za „{{ query }}“ <span class="text-muted">({{ found|length }})</span></div>
        {% for item in found %}{% include 'todo/_item.html.twig' with {item: item, section: 'found'} only %}{% else %}
            <div class="kt-todo-empty">Ništa nije pronađeno.</div>
        {% endfor %}
    </div>
{% else %}
    {% set total = sections.overdue|length + sections.today|length + sections.upcoming|length + sections.nodue|length %}
    {% for key, title in titles %}
        {% if sections[key] is not empty %}
            <div class="kt-todo-section {{ key == 'overdue' ? 'is-danger' : '' }}" data-todo-section="{{ key }}">
                <div class="kt-todo-head">{{ title }} <span class="text-muted">({{ sections[key]|length }})</span></div>
                <div class="kt-todo-items" {{ key == 'nodue' ? 'data-todo-sortable' }}>
                    {% for item in sections[key] %}{% include 'todo/_item.html.twig' with {item: item, section: key} only %}{% endfor %}
                </div>
            </div>
        {% endif %}
    {% endfor %}
    {% if total == 0 %}
        <div class="kt-todo-empty">{{ ux_icon('lucide:notebook-pen', {class: 'kt-icon kt-icon-lg d-block mb-2'}) }}Podsetnik je prazan.<button type="button" class="btn btn-primary mt-3 d-block mx-auto" data-todo-new>{{ ux_icon('lucide:plus', {class: 'kt-icon me-1'}) }}Dodaj</button></div>
    {% endif %}
    {% if sections.done is not empty %}
        <details class="kt-todo-section kt-todo-done">
            <summary class="kt-todo-head">Završene <span class="text-muted">({{ sections.done|length }})</span></summary>
            <p class="kt-text-sm text-muted px-3 pt-2 mb-0">Završene stavke se brišu posle 3 dana.</p>
            <div class="kt-todo-items">
                {% for item in sections.done %}{% include 'todo/_item.html.twig' with {item: item, section: 'done'} only %}{% endfor %}
            </div>
        </details>
    {% endif %}
{% endif %}
