{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}
{% import 'components/timeline.html.twig' as tl %}

{% block title %}Moj profil{% endblock %}
{% block page_title %}Moj profil{% endblock %}
{% block page_actions %}<a href="{{ path('user_tasks', {id: app.user.id}) }}" class="btn btn-light">{{ ux_icon('lucide:list-checks', {class: 'kt-icon me-2'}) }}Moji zadaci</a> <a href="{{ path('user_documents', {id: app.user.id}) }}" class="btn btn-light">{{ ux_icon('lucide:folder', {class: 'kt-icon me-2'}) }}Moji dokumenti</a>{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lični podaci</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(profileForm) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(profileForm.firstName) }}</div>
                            <div class="col-md-6">{{ form_row(profileForm.lastName) }}</div>
                        </div>
                        {{ form_row(profileForm.phone) }}
                        {{ form_row(profileForm.address) }}
                        <div class="row">
                            <div class="col-md-8">{{ form_row(profileForm.city) }}</div>
                            <div class="col-md-4">{{ form_row(profileForm.postalCode) }}</div>
                        </div>
                        <div class="kt-form-actions">
                            <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Nalog</h5>
                </div>

                <div class="card-body border-top">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">{{ app.user.email }}</dd>
                        <dt class="col-sm-4">Rola</dt><dd class="col-sm-8">{{ ui.role_badge(app.user.highestRole) }}</dd>
                        <dt class="col-sm-4">Pozicija</dt><dd class="col-sm-8">{{ app.user.position ?? '—' }}</dd>
                        <dt class="col-sm-4">Tim</dt>
                        <dd class="col-sm-8">
                            {% if membership %}{{ ui.team_badge(membership.team) }}{% else %}<span class="text-muted">—</span>{% endif %}
                        </dd>
                        {% if ledTeam %}
                            <dt class="col-sm-4">Šef tima</dt><dd class="col-sm-8">{{ ui.team_badge(ledTeam) }}</dd>
                        {% endif %}
                    </dl>
                    <div class="text-muted kt-text-sm mt-3">Email, rolu i poziciju menja administrator.</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ ux_icon('lucide:bell', {class: 'kt-icon me-2'}) }}Obaveštenja na mail</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(prefsForm) }}
                        {{ form_row(prefsForm.emailNotifications) }}
                        <div class="text-muted kt-text-sm mb-3">U aplikaciji (zvonce) uvek dobijaš sva obaveštenja. Mail se šalje samo za izabrano, a pošiljalac može da ga uključi i za pojedinačan zadatak.</div>
                        <div class="kt-form-actions">
                            <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(prefsForm) }}
                </div>
            </div>

            {# Google kalendar (SPEC 8n.3): aplikacija -> Google, poseban kalendar "KontIT" #}
            {% set gc = google_connection(app.user) %}
            <div class="card" id="google">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:calendar-days', {class: 'kt-icon me-2'}) }}Google kalendar</h5></div>
                <div class="card-body border-top">
                    {% if gc %}
                        <p class="mb-1">Povezano: <strong>{{ gc.googleEmail ?? 'Google nalog' }}</strong>, kalendar „KontIT“.</p>
                        <p class="kt-text-sm text-muted mb-2">Povezano {{ gc.connectedAt|date('d.m.Y.') }}{% if gc.lastSyncAt %} · poslednje osvežavanje {{ gc.lastSyncAt|date('d.m.Y. H:i') }}{% endif %}</p>
                        {% if gc.lastError %}<div class="kt-text-sm text-danger mb-2">{{ ux_icon('lucide:circle-alert', {class: 'kt-icon me-1'}) }}{{ gc.lastError }}</div>{% endif %}
                        <form method="post" action="{{ path('profile_google_disconnect') }}" {{ confirm_attrs('Odvezati Google kalendar?', 'Novi događaji se više neće upisivati. Kalendar „KontIT“ ostaje u tvom Google nalogu.', 'warning', 'Da, odveži') }}>
                            <input type="hidden" name="_token" value="{{ csrf_token('google_disconnect') }}">
                            <button class="btn btn-light btn-sm">Odveži</button>
                        </form>
                    {% elseif google_calendar_active() %}
                        <p class="kt-text-sm text-muted">Tvoji zadaci (na dan roka) i odobrena odsustva se upisuju u poseban kalendar „KontIT“ u tvom Google nalogu. Lični kalendar ostaje netaknut. Izmene u Google-u se ne vraćaju u aplikaciju.</p>
                        <a href="{{ path('connect_google') }}" class="btn btn-primary btn-sm">Poveži Google kalendar</a>
                    {% else %}
                        <p class="kt-text-sm text-muted mb-0">Povezivanje još nije uključeno: administrator treba da podesi Google pristup. Do tada možeš da koristiš ICS link ispod.</p>
                    {% endif %}
                </div>
            </div>

            {# ICS pretplata (SPEC 8n): tajni link, samo čitanje #}
            <div class="card" id="ics">
                <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:calendar-check', {class: 'kt-icon me-2'}) }}Kalendar u drugoj aplikaciji</h5></div>
                <div class="card-body border-top">
                    <p class="kt-text-sm text-muted">Tajni link za pretplatu (Google, Outlook, iPhone): tvoji zadaci po roku i odobrena odsustva. Samo čitanje. Ko ima link, vidi te događaje, pa ga ne deli.</p>
                    {% if app.user.icsToken %}
                        {% set ics = url('calendar_ics', {token: app.user.icsToken}) %}
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" class="form-control kt-mono" value="{{ ics }}" readonly id="ics-url" aria-label="ICS link">
                            <button type="button" class="btn btn-light" onclick="navigator.clipboard.writeText(document.getElementById('ics-url').value).then(() => window.ktToast('Link je kopiran.'))">{{ ux_icon('lucide:clipboard-list', {class: 'kt-icon me-1'}) }}Kopiraj</button>
                        </div>
                        <form method="post" action="{{ path('profile_ics') }}" class="d-inline" {{ confirm_attrs('Napraviti nov link?', 'Stari link prestaje da radi; u kalendaru ga zameni novim.', 'warning', 'Da, nov link') }}>
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_ics') }}">
                            <button class="btn btn-light btn-sm">Nov link</button>
                        </form>
                        <form method="post" action="{{ path('profile_ics') }}" class="d-inline" {{ confirm_attrs('Poništiti link?', 'Kalendar koji koristi ovaj link više neće dobijati događaje.', 'danger', 'Da, poništi') }}>
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_ics') }}">
                            <input type="hidden" name="action" value="revoke">
                            <button class="btn btn-ghost btn-sm text-danger">Poništi</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('profile_ics') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('profile_ics') }}">
                            <button class="btn btn-primary btn-sm">Napravi link</button>
                        </form>
                    {% endif %}
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Promena lozinke</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(passwordForm) }}
                        {{ form_row(passwordForm.currentPassword) }}
                        {{ form_row(passwordForm.plainPassword.first) }}
                        {{ form_row(passwordForm.plainPassword.second) }}
                        <div class="kt-form-actions">
                            <button class="btn btn-light">Promeni lozinku{{ ux_icon('lucide:lock-keyhole', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(passwordForm) }}
                </div>
            </div>
        </div>
    </div>
    {{ include('absence/_user_card.html.twig', {person: app.user}) }}
    <div class="card">
        <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:history', {class: 'kt-icon me-2'}) }}Aktivnost</h5></div>
        <div class="card-body border-top">{{ tl.feed(path('ajax_user_activity', {id: app.user.id}), activity, true) }}</div>
    </div>
{% endblock %}
