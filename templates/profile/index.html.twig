{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}
{% import 'components/timeline.html.twig' as tl %}

{% block title %}Moj profil{% endblock %}
{% block page_title %}Moj profil{% endblock %}
{% block page_actions %}<a href="{{ path('user_documents', {id: app.user.id}) }}" class="btn btn-light">{{ ux_icon('lucide:folder', {class: 'kt-icon me-2'}) }}Moji dokumenti</a>{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lični podaci</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(profileForm) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(profileForm.firstName) }}</div>
                            <div class="col-md-6">{{ form_row(profileForm.lastName) }}</div>
                        </div>
                        {{ form_row(profileForm.phone) }}
                        {{ form_row(profileForm.address) }}
                        <div class="row">
                            <div class="col-md-8">{{ form_row(profileForm.city) }}</div>
                            <div class="col-md-4">{{ form_row(profileForm.postalCode) }}</div>
                        </div>
                        <div class="kt-form-actions">
                            <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Nalog</h5>
                </div>

                <div class="card-body border-top">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">{{ app.user.email }}</dd>
                        <dt class="col-sm-4">Rola</dt><dd class="col-sm-8">{{ ui.role_badge(app.user.highestRole) }}</dd>
                        <dt class="col-sm-4">Pozicija</dt><dd class="col-sm-8">{{ app.user.position ?? '—' }}</dd>
                        <dt class="col-sm-4">Tim</dt>
                        <dd class="col-sm-8">
                            {% if membership %}{{ ui.team_badge(membership.team) }}{% else %}<span class="text-muted">—</span>{% endif %}
                        </dd>
                        {% if ledTeam %}
                            <dt class="col-sm-4">Šef tima</dt><dd class="col-sm-8">{{ ui.team_badge(ledTeam) }}</dd>
                        {% endif %}
                    </dl>
                    <div class="text-muted kt-text-sm mt-3">Email, rolu i poziciju menja administrator.</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ ux_icon('lucide:bell', {class: 'kt-icon me-2'}) }}Obaveštenja na mail</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(prefsForm) }}
                        {{ form_row(prefsForm.emailNotifications) }}
                        <div class="text-muted kt-text-sm mb-3">U aplikaciji (zvonce) uvek dobijaš sva obaveštenja. Mail se šalje samo za izabrano, a pošiljalac može da ga uključi i za pojedinačan zadatak.</div>
                        <div class="kt-form-actions">
                            <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(prefsForm) }}
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Promena lozinke</h5>
                </div>

                <div class="card-body border-top">
                    {{ form_start(passwordForm) }}
                        {{ form_row(passwordForm.currentPassword) }}
                        {{ form_row(passwordForm.plainPassword.first) }}
                        {{ form_row(passwordForm.plainPassword.second) }}
                        <div class="kt-form-actions">
                            <button class="btn btn-light">Promeni lozinku{{ ux_icon('lucide:lock-keyhole', {class: 'kt-icon ms-2'}) }}</button>
                        </div>
                    {{ form_end(passwordForm) }}
                </div>
            </div>
        </div>
    </div>
    {{ include('absence/_user_card.html.twig', {person: app.user}) }}
    <div class="card">
        <div class="card-header"><h5 class="mb-0">{{ ux_icon('lucide:history', {class: 'kt-icon me-2'}) }}Aktivnost</h5></div>
        <div class="card-body border-top">{{ tl.feed(path('ajax_user_activity', {id: app.user.id}), activity, true) }}</div>
    </div>
{% endblock %}
