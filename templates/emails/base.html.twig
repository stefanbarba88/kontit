<!doctype html>
<html lang="sr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}KontIT app{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#F5F6F8;font-family:Inter,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#1F2329;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F5F6F8;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
                <tr>
                    <td style="padding:8px 4px 20px;">
                        <img src="{{ url('app_dashboard')|trim('/', 'right') }}/brand/kontit-app-lockup-email@2x.png" alt="KontIT app" width="220" style="display:block;width:220px;height:auto;border:0;">
                    </td>
                </tr>
                <tr>
                    <td style="background-color:#fff;padding:28px 24px;border:1px solid #E4E7EB;border-radius:14px;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="padding:16px 24px;text-align:center;font-size:12px;color:#8A929D;">
                        {% block footer %}KontIT app · Ova poruka je poslata automatski.{% endblock %}<br>
                        <a href="{{ url('app_profile') }}" style="color:#006FD6;text-decoration:none;">Podešavanja obaveštenja</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
