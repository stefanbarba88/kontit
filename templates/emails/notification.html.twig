{% extends 'emails/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <h2 style="margin:0 0 16px;font-size:20px;color:#1F2329;">{{ title }}</h2>
    <p style="margin:0 0 24px;">{{ message|nl2br }}</p>
    {% if url %}
        <p style="margin:0 0 24px;">
            <a href="{{ url }}" style="display:inline-block;background-color:#006FD6;color:#fff;text-decoration:none;padding:10px 20px;border-radius:10px;font-weight:600;">Otvori</a>
        </p>
    {% endif %}
    <p style="margin:0;font-size:13px;color:#5E6672;">Koja obaveštenja dobijaš na mail možeš da podesi u svom profilu.</p>
{% endblock %}
