{% extends 'base_auth.html.twig' %}

{% block title %}Nova lozinka{% endblock %}

{% block auth_icon %}
    <div class="d-inline-flex bg-primary bg-opacity-10 text-primary lh-1 rounded-pill p-3 mb-3 mt-1">
        {{ ux_icon('lucide:lock-keyhole', {class: 'kt-icon kt-icon-lg'}) }}
    </div>
{% endblock %}
{% block auth_title %}Nova lozinka{% endblock %}
{% block auth_subtitle %}Postavi novu lozinku za nalog{% endblock %}

{% block auth_content %}
    {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword.first) }}
        {{ form_row(resetForm.plainPassword.second) }}
        <button type="submit" class="btn btn-primary w-100">Sačuvaj lozinku</button>
    {{ form_end(resetForm) }}
{% endblock %}
