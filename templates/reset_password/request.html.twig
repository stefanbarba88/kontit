{% extends 'base_auth.html.twig' %}

{% block title %}Resetovanje lozinke{% endblock %}

{% block auth_icon %}
    <div class="d-inline-flex bg-primary bg-opacity-10 text-primary lh-1 rounded-pill p-3 mb-3 mt-1">
        {{ ux_icon('lucide:rotate-ccw', {class: 'kt-icon kt-icon-lg'}) }}
    </div>
{% endblock %}
{% block auth_title %}Resetovanje lozinke{% endblock %}
{% block auth_subtitle %}Poslaćemo ti uputstvo na email{% endblock %}

{% block auth_content %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger kt-alert" role="alert">
            <span class="kt-alert-icon">{{ ux_icon('lucide:circle-x', {class: 'kt-icon'}) }}</span>
            {{ flash_error }}
        </div>
    {% endfor %}

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email, {label: 'Email', attr: {placeholder: 'ime@firma.rs'}}) }}
        <div class="mb-3">
            <button type="submit" class="btn btn-primary w-100">{{ ux_icon('lucide:mail', {class: 'kt-icon me-2'}) }}Pošalji link</button>
        </div>
        <div class="text-center">
            <a href="{{ path('app_login') }}">Nazad na prijavu</a>
        </div>
    {{ form_end(requestForm) }}
{% endblock %}
