{% extends 'base.html.twig' %}

{% set is_new = client.id is null %}

{% block title %}{{ is_new ? 'Novi klijent' : 'Izmena klijenta' }}{% endblock %}
{% block page_title %}{{ is_new ? 'Novi klijent' : 'Izmena: ' ~ client.shortName }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('client_index') }}" class="breadcrumb-item">Klijenti</a>
    {% if not is_new %}<a href="{{ path('client_show', {id: client.id}) }}" class="breadcrumb-item">{{ client.shortName }}</a>{% endif %}
    <span class="breadcrumb-item active">{{ is_new ? 'Novi' : 'Izmena' }}</span>
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Podaci o klijentu</h5></div>
                <div class="card-body border-top">
                    {{ form_row(form.name) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.shortName) }}</div>
                        <div class="col-md-6">{{ form_row(form.startDate) }}</div>
                    </div>
                    <div class="row">
                        <div class="col-md-5">
                            {{ form_label(form.pib) }}
                            <div class="input-group mb-3">
                                {{ form_widget(form.pib) }}
                                {% if nbs_configured %}<button type="button" class="btn btn-outline-primary" id="nbs-fetch" data-url="{{ path('ajax_client_lookup') }}" data-exclude="{{ client.id ?? 0 }}">{{ ux_icon('lucide:cloud-download', {class: 'kt-icon me-1'}) }}Učitaj iz NBS</button>{% endif %}
                            </div>
                            {{ form_errors(form.pib) }}
                        </div>
                        <div class="col-md-5">{{ form_row(form.maticniBroj) }}</div>
                        <div class="col-md-2 d-flex align-items-center pt-3">{{ form_row(form.pdvObveznik) }}</div>
                    </div>
                    <div id="nbs-accounts" class="mb-3 d-none">
                        <div class="kt-overline mb-1">Tekući računi iz NBS-a</div>
                        <ul class="list-unstyled mb-0 kt-text-sm"></ul>
                    </div>
                    {{ form_row(form.note) }}
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Zaduženi radnici</h5></div>
                <div class="card-body border-top">
                    {{ form_row(form.primary) }}
                    {{ form_row(form.backup) }}
                    <div class="text-muted kt-text-sm">Promene dodele se beleže u istoriji klijenta.</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">Kontakt</h5></div>
                <div class="card-body border-top">
                    {{ form_row(form.contactPerson) }}
                    {{ form_row(form.phone) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.address) }}
                    <div class="row">
                        <div class="col-4">{{ form_row(form.postalCode) }}</div>
                        <div class="col-8">{{ form_row(form.city) }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ is_new ? path('client_index') : path('client_show', {id: client.id}) }}" class="btn btn-light">Otkaži</a>
        <button class="btn btn-primary">Sačuvaj{{ ux_icon('lucide:save', {class: 'kt-icon ms-2'}) }}</button>
    </div>
    {{ form_end(form) }}
{% endblock %}
