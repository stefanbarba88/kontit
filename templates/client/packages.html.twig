{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Paketi i poslovi — {{ client.shortName }}{% endblock %}
{% block page_title %}Paketi i poslovi: {{ client.shortName }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('client_show', {id: client.id}) }}" class="breadcrumb-item">{{ client.shortName }}</a>
    <span class="breadcrumb-item active">Paketi i poslovi</span>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('client_job_new', {id: client.id}) }}" class="btn btn-outline-primary">{{ ux_icon('lucide:plus', {class: 'kt-icon me-2'}) }}{{ is_granted('CATALOG_MANAGE') ? 'Ad hoc posao' : 'Predloži posao' }}</a>
    {% if is_granted('CATALOG_MANAGE') %}
        <a href="{{ path('client_package_attach', {id: client.id}) }}" class="btn btn-primary">{{ ux_icon('lucide:package', {class: 'kt-icon me-2'}) }}Dodeli paket</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header"><h5 class="mb-0">Paketi</h5></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Paket</th><th>Period</th>{% if is_granted('PRICE_VIEW') %}<th>Dogovorena cena</th>{% endif %}<th>Status</th><th style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for cp in clientPackages %}
                        <tr>
                            <td>{{ cp.package.name }}{% if cp.note %}<div class="text-muted kt-text-sm">{{ cp.note }}</div>{% endif %}</td>
                            <td>{{ cp.startDate|date('d.m.Y.') }} – {{ cp.endDate ? cp.endDate|date('d.m.Y.') : '…' }}</td>
                            {% if is_granted('PRICE_VIEW') %}
                                <td>
                                    {{ cp.agreedPrice|number_format(2, ',', '.') }} RSD
                                    {% if cp.discountPercent %}<span class="badge bg-success ms-1">-{{ cp.discountPercent }}%</span>{% endif %}
                                    {% if cp.active %}
                                        <form method="post" action="{{ path('client_package_price', {id: cp.id}) }}" class="d-flex gap-1 mt-1" {{ confirm_attrs('Promeniti dogovorenu cenu?', 'Promena se beleži u istoriji cena.', 'warning', 'Da, promeni') }}>
                                            <input type="hidden" name="_token" value="{{ csrf_token('client_package_price_' ~ cp.id) }}">
                                            <input type="text" name="price" class="form-control form-control-sm" style="width: 110px;" placeholder="nova cena" required>
                                            <input type="date" name="from" class="form-control form-control-sm" style="width: 140px;" value="{{ 'now'|date('Y-m-d') }}">
                                            <button class="btn btn-light btn-sm">Primeni</button>
                                        </form>
                                    {% endif %}
                                </td>
                            {% endif %}
                            <td>{{ ui.status_badge(cp.active) }}</td>
                            <td>
                                {% if cp.active and is_granted('CATALOG_MANAGE') %}
                                    <form method="post" action="{{ path('client_package_remove', {id: cp.id}) }}" {{ confirm_attrs('Ukinuti paket klijentu?', 'Svi poslovi iz ovog paketa se završavaju danas. Istorija ostaje.', 'danger', 'Da, ukini', true) }}>
                                        <input type="hidden" name="_token" value="{{ csrf_token('client_package_remove_' ~ cp.id) }}">
                                        <div class="form-check mb-1"><input type="checkbox" class="form-check-input" name="cancel_tasks" value="1" id="ct{{ cp.id }}"><label class="form-check-label kt-text-sm" for="ct{{ cp.id }}">otkaži otvorene zadatke</label></div>
                                        <button class="btn btn-outline-danger btn-sm">Ukini paket</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5">{{ ui.empty_state('Klijent nema nijedan paket.', 'package') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">Poslovi</h5></div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Posao</th><th>Izvor</th><th>Ponavljanje</th><th>Period</th>{% if is_granted('PRICE_VIEW') %}<th>Cena</th>{% endif %}<th>Status</th><th style="width: 1%;"></th></tr>
                </thead>
                <tbody>
                    {% for job in jobs %}
                        <tr class="{{ job.excluded or not job.active ? 'text-muted' : '' }}">
                            <td>
                                {{ job.jobTemplate.name }}
                                {% if job.excluded %}<div class="kt-text-sm text-danger">Isključen: {{ job.excludedReason }}</div>{% endif %}
                                {% if not job.approved %}<div class="kt-text-sm text-warning">Čeka odobrenje{% if job.proposedBy %} ({{ job.proposedBy.fullName }}){% endif %}</div>{% endif %}
                            </td>
                            <td>{{ job.source.label }}</td>
                            <td>{{ job.recurrence.label }}</td>
                            <td>{{ job.startDate|date('d.m.Y.') }} – {{ job.endDate ? job.endDate|date('d.m.Y.') : '…' }}</td>
                            {% if is_granted('PRICE_VIEW') %}<td>{{ job.price is not null ? job.price|number_format(2, ',', '.') ~ ' RSD' : '—' }}</td>{% endif %}
                            <td>
                                {% if not job.approved %}<span class="badge bg-warning">Predlog</span>
                                {% elseif job.excluded %}<span class="badge bg-danger">Isključen</span>
                                {% else %}{{ ui.status_badge(job.active) }}{% endif %}
                            </td>
                            <td class="text-nowrap">
                                {% if is_granted('CATALOG_MANAGE') %}
                                    {% if not job.approved %}
                                        <form method="post" action="{{ path('client_job_approve', {id: job.id}) }}" class="d-flex gap-1" {{ confirm_attrs('Odobriti predlog posla?', 'Posao će se odmah uključiti u generisanje zadataka.', 'info', 'Da, odobri') }}>
                                            <input type="hidden" name="_token" value="{{ csrf_token('client_job_' ~ job.id) }}">
                                            <input type="text" name="price" class="form-control form-control-sm" style="width: 90px;" placeholder="cena">
                                            <button class="btn btn-success btn-sm">Odobri</button>
                                        </form>
                                    {% elseif job.excluded %}
                                        <form method="post" action="{{ path('client_job_include', {id: job.id}) }}" {{ confirm_attrs('Ponovo uključiti posao?', 'Zadaci će se ponovo generisati.', 'info', 'Da, uključi') }}>
                                            <input type="hidden" name="_token" value="{{ csrf_token('client_job_' ~ job.id) }}">
                                            <button class="btn btn-outline-success btn-sm">Uključi</button>
                                        </form>
                                    {% elseif job.active %}
                                        {% if job.source.value == 'PACKAGE' %}
                                            <form method="post" action="{{ path('client_job_exclude', {id: job.id}) }}" class="d-inline" {{ confirm_attrs('Isključiti posao za ovog klijenta?', 'Zadaci za ovaj posao se više neće generisati.', 'warning', 'Da, isključi', true) }}>
                                                <input type="hidden" name="_token" value="{{ csrf_token('client_job_' ~ job.id) }}">
                                                <input type="hidden" name="cancel_tasks" value="1">
                                                <button class="btn btn-outline-warning btn-sm">Isključi</button>
                                            </form>
                                        {% else %}
                                            <form method="post" action="{{ path('client_job_end', {id: job.id}) }}" class="d-inline" {{ confirm_attrs('Ukinuti posao?', 'Posao se završava danas.', 'danger', 'Da, ukini', true) }}>
                                                <input type="hidden" name="_token" value="{{ csrf_token('client_job_' ~ job.id) }}">
                                                <input type="hidden" name="cancel_tasks" value="1">
                                                <button class="btn btn-outline-danger btn-sm">Ukini</button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">{{ ui.empty_state('Klijent nema poslova.', 'list-checks') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if priceLog|length %}
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Istorija cena</h5></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Od</th><th>Paket</th><th>Stara</th><th>Nova</th><th>Promenio</th></tr></thead>
                    <tbody>
                        {% for log in priceLog %}
                            <tr>
                                <td>{{ log.effectiveFrom|date('d.m.Y.') }}</td>
                                <td>{{ log.clientPackage.package.name }}</td>
                                <td>{{ log.oldPrice is not null ? log.oldPrice|number_format(2, ',', '.') : '—' }}</td>
                                <td>{{ log.newPrice|number_format(2, ',', '.') }}</td>
                                <td>{{ log.changedBy ? log.changedBy.fullName : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
