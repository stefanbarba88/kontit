{% extends 'base.html.twig' %}

{% block title %}{{ isAdmin ? 'Ad hoc posao' : 'Predlog posla' }} — {{ client.name }}{% endblock %}
{% block page_title %}{{ isAdmin ? 'Ad hoc posao' : 'Predlog posla' }}: {{ client.name }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('client_show', {id: client.id}) }}" class="breadcrumb-item">{{ client.name }}</a>
    <a href="{{ path('client_packages', {id: client.id}) }}" class="breadcrumb-item">Paketi i poslovi</a>
    <span class="breadcrumb-item active">{{ isAdmin ? 'Novi posao' : 'Predlog' }}</span>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">{{ isAdmin ? 'Posao van paketa' : 'Predlog posla administratoru' }}</h5></div>
                <div class="card-body border-top">
                    {% if not isAdmin %}<div class="alert alert-info">Posao postaje aktivan tek kada ga administrator odobri i odredi cenu.</div>{% endif %}
                    {{ form_start(form) }}
                        {{ form_row(form.jobTemplate) }}
                        {{ form_row(form.startDate) }}
                        {{ form_row(form.endDate) }}
                        {% if form.price is defined %}{{ form_row(form.price) }}{% endif %}
                        <div class="text-end">
                            <a href="{{ path('client_packages', {id: client.id}) }}" class="btn btn-light me-2">Otkaži</a>
                            <button class="btn btn-primary">{{ isAdmin ? 'Sačuvaj' : 'Pošalji predlog' }}<i class="ph-check ms-2"></i></button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
