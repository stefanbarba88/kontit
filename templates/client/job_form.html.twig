{% extends 'base.html.twig' %}
{% import 'components/_job_picker.html.twig' as jp %}

{% block title %}{{ isAdmin ? 'Pojedinačan posao' : 'Predlog posla' }} — {{ client.shortName }}{% endblock %}
{% block page_title %}{{ isAdmin ? 'Dodaj pojedinačan posao' : 'Predloži posao' }}: {{ client.shortName }}{% endblock %}
{% block breadcrumbs %}
    <a href="{{ path('client_show', {id: client.id}) }}" class="breadcrumb-item">{{ client.shortName }}</a>
    <a href="{{ path('client_show', {id: client.id, tab: 'usluge'}) }}" class="breadcrumb-item">Ugovorene usluge</a>
    <span class="breadcrumb-item active">{{ isAdmin ? 'Pojedinačan posao' : 'Predlog' }}</span>
{% endblock %}

{% block content %}
    {# isto kao modal na tabu "Ugovorene usluge" #}
    {% if isAdmin %}{{ include('components/_schedule_dialog.html.twig') }}{% endif %}
    <template id="jp-extra-page">
        <div class="kt-jp-extra">
            {% if isAdmin %}
                <input type="text" class="form-control form-control-sm" name="price[__ID__]" value="__PRICE__" placeholder="Cena (RSD)" data-kt-money aria-label="Cena">
                <select class="form-select form-select-sm" name="assignee[__ID__]" data-native aria-label="Zaduženi">
                    <option value="">Glavni radnik ({{ client.primaryAccountant.fullName }})</option>
                    {% for u in assignees %}{% if u != client.primaryAccountant %}<option value="{{ u.id }}">{{ u.fullName }}</option>{% endif %}{% endfor %}
                </select>
            {% endif %}
            <input type="text" class="form-control form-control-sm kt-jp-extra-wide" name="note[__ID__]" placeholder="Napomena (opciono)" maxlength="500" aria-label="Napomena">
            {% if isAdmin %}<div class="kt-jp-extra-wide" data-kt-sched-row data-job-id="__ID__" data-job-name="__NAME__" data-default='__SCHEDULE__' data-default-text="__DESCRIBE__" data-anchor="{{ 'now'|date('Y-m-d') }}"></div>{% endif %}
        </div>
    </template>
    <div class="card">
        <form method="post" class="card-body">
            <input type="hidden" name="_token" value="{{ csrf_token('client_jobs_new_' ~ client.id) }}">
            {% if not isAdmin %}<div class="alert alert-info">Predlog ide administratoru, koji upisuje cenu i odobrava ga. Do odobrenja se zadaci ne prave.</div>{% endif %}
            {{ jp.picker('jobs', [], 'jp-extra-page') }}
            <div class="row mt-3">
                <div class="col-sm-6 col-md-3">
                    <label class="form-label" for="ind-start">Početak</label>
                    <input type="text" data-datepicker class="form-control" id="ind-start" name="startDate" value="{{ 'now'|date('Y-m-d') }}">
                </div>
            </div>
            <div class="kt-form-actions">
                <button class="btn btn-primary">{{ isAdmin ? 'Dodaj' : 'Pošalji predlog' }}</button>
                <a href="{{ path('client_show', {id: client.id, tab: 'usluge'}) }}" class="btn btn-outline-secondary">Odustani</a>
            </div>
        </form>
    </div>
{% endblock %}
