{% extends 'base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block title %}Notifikacije{% endblock %}
{% block page_title %}Notifikacije{% endblock %}
{% block breadcrumbs %}<span class="breadcrumb-item active">Notifikacije</span>{% endblock %}

{% block page_actions %}
    {% if unreadCount > 0 %}
        <form method="post" action="{{ path('notification_read_all') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
            <button class="btn btn-light"><i class="ph-checks me-2"></i>Označi sve kao pročitano</button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="card">
        <ul class="nav nav-tabs nav-tabs-underline px-3 pt-2">
            <li class="nav-item"><a href="{{ path('notification_index') }}" class="nav-link {{ onlyUnread ? '' : 'active' }}">Sve</a></li>
            <li class="nav-item">
                <a href="{{ path('notification_index', {unread: 1}) }}" class="nav-link {{ onlyUnread ? 'active' : '' }}">
                    Nepročitane{% if unreadCount > 0 %}<span class="badge bg-danger rounded-pill ms-2">{{ unreadCount }}</span>{% endif %}
                </a>
            </li>
        </ul>

        <div class="list-group list-group-flush border-top">
            {% for n in pagination %}
                <a href="{{ path('notification_open', {id: n.id}) }}" class="list-group-item list-group-item-action d-flex align-items-start {{ n.read ? '' : 'bg-primary bg-opacity-10' }}">
                    <div class="me-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-{{ n.type.color }} bg-opacity-10 text-{{ n.type.color }} rounded-pill w-40px h-40px">
                            <i class="{{ n.type.icon }}"></i>
                        </span>
                    </div>
                    <div class="flex-fill">
                        <div class="{{ n.read ? '' : 'fw-semibold' }}">{{ n.title }}</div>
                        <div class="text-muted">{{ n.message|nl2br }}</div>
                    </div>
                    <div class="text-muted fs-sm ms-3 text-nowrap">
                        {{ n.createdAt|date('d.m.Y. H:i') }}
                        {% if n.emailSent %}<i class="ph-envelope-simple ms-1" title="Poslato i na mail"></i>{% endif %}
                    </div>
                </a>
            {% else %}
                <div class="p-3">{{ ui.empty_state(onlyUnread ? 'Nema nepročitanih notifikacija.' : 'Još nemate notifikacija.', 'ph-bell') }}</div>
            {% endfor %}
        </div>
    </div>

    <div class="d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
